  const lat=Number(input.lat),lon=Number(input.lon);
  if(!RESCUE_TYPES.includes(type))throw new Error('Choose a valid incident type.');
  if(!['earthquake','water'].includes(hazard)||(hazard==='water'?WATER_INCIDENT_TYPES:SEISMIC_INCIDENT_TYPES).includes(type)===false)throw new Error('Incident type does not match selected disaster.');
  if(!RESCUE_PRIORITIES.includes(urgency))throw new Error('Choose a valid reported urgency.');
  if(!place || place.length>90)throw new Error('Enter a location or landmark (up to 90 characters).');
  if(!description || description.length>400)throw new Error('Enter a short report description (up to 400 characters).');
  if(!Number.isFinite(lat)||!Number.isFinite(lon)||Math.abs(lat)>90||Math.abs(lon)>180)throw new Error('Latitude or longitude is invalid.');
  return {hazard,type,urgency,place,description,lat,lon};
}
