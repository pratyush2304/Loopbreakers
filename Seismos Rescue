  #theme-toggle{font-size:9px}
  #mapCanvas{touch-action:none}
}


/* FULL-STACK AUTHENTICATION UI */
.auth-header{font:700 9px var(--mono);border:1px solid var(--border);color:var(--accent);border-radius:7px;padding:7px 8px;white-space:nowrap}
#audit-section .audit-entry{font-size:10px;line-height:1.55;padding:7px 0;border-bottom:1px solid var(--border);overflow-wrap:anywhere}
#auth-form[style*="display: none"]{display:none}
#auth-user-actions[hidden],#auth-name-wrap[hidden],#audit-section[hidden]{display:none!important}
body[data-theme="light"] #auth-section,body[data-theme="light"] #account-section{color:var(--text-hi)}
@media(max-width:1100px){.auth-header{display:none}}

/* ================================================================
   GLASS UI / SEISMOS RESCUE 2.1
   Optional frosted-glass appearance, applied only when enabled.
   Clear alert labels, map/source status and form fields retain
   solid-enough backgrounds to remain readable on satellite imagery.
   ================================================================ */
body[data-glass="on"] {
  --glass-blur:18px;
  --glass-surface:rgba(13,23,38,.73);
  --glass-surface-raised:rgba(25,40,57,.78);
  --glass-card:rgba(37,52,72,.49);
  --glass-border:rgba(201,237,255,.19);
  --glass-highlight:rgba(255,255,255,.12);
  --glass-shadow:rgba(0,0,0,.28);
  --glass-control:rgba(25,40,58,.7);
  --glass-input:rgba(7,16,28,.72);
  --glass-hud:rgba(9,20,32,.88);
}
body[data-glass="on"][data-theme="light"] {
  --glass-surface:rgba(245,251,255,.77);
  --glass-surface-raised:rgba(255,255,255,.84);
  --glass-card:rgba(255,255,255,.69);
  --glass-border:rgba(255,255,255,.86);
  --glass-highlight:rgba(255,255,255,.94);
  --glass-shadow:rgba(17,55,83,.12);
  --glass-control:rgba(245,252,255,.8);
  --glass-input:rgba(255,255,255,.82);
  --glass-hud:rgba(248,253,255,.91);
}
body[data-glass="on"] #app {
  background:transparent;
  position:relative;
  isolation:isolate;
}
/* Ambient glow is behind the panels, not on top of map imagery. */
body[data-glass="on"] #app::before {
  content:"";position:absolute;inset:0;z-index:0;pointer-events:none;
  background:
    radial-gradient(ellipse 48% 70% at 82% 12%,rgba(41,169,160,.18),transparent 73%),
    radial-gradient(ellipse 50% 65% at 10% 88%,rgba(57,89,170,.16),transparent 73%),
    linear-gradient(135deg,#050a12,#0b1a2b 59%,#0a111e);
}
body[data-glass="on"][data-theme="light"] #app::before {
  background:
    radial-gradient(ellipse 56% 62% at 84% 18%,rgba(66,185,180,.24),transparent 73%),
    radial-gradient(ellipse 53% 66% at 10% 87%,rgba(110,155,217,.21),transparent 74%),
    linear-gradient(130deg,#e9f4fc,#f5faff 50%,#d9ebf5);
}
body[data-glass="on"] #app::after {
  content:"";position:absolute;inset:0;z-index:0;pointer-events:none;opacity:.24;
  background-image:linear-gradient(rgba(170,214,230,.045) 1px,transparent 1px),
                   linear-gradient(90deg,rgba(170,214,230,.045) 1px,transparent 1px);
  background-size:34px 34px;
}
body[data-glass="on"] #canvas-wrap,body[data-glass="on"] #seismo-wrap{z-index:1}
body[data-glass="on"] #topbar {
  background:linear-gradient(112deg,var(--glass-surface-raised),var(--glass-surface));
  border-bottom:1px solid var(--glass-border);
  -webkit-backdrop-filter:blur(24px) saturate(145%);backdrop-filter:blur(24px) saturate(145%);
  box-shadow:0 7px 34px var(--glass-shadow),inset 0 1px var(--glass-highlight);
}
body[data-glass="on"] #sidebar {
  background:linear-gradient(156deg,var(--glass-surface),rgba(13,29,45,.67));
  border-left:1px solid var(--glass-border);
  -webkit-backdrop-filter:blur(24px) saturate(150%);backdrop-filter:blur(24px) saturate(150%);
  box-shadow:-9px 0 33px var(--glass-shadow),inset 1px 0 var(--glass-highlight);
}
body[data-glass="on"][data-theme="light"] #sidebar {
  background:linear-gradient(152deg,rgba(250,254,255,.85),rgba(230,245,253,.73));
}
body[data-glass="on"] #seismo-wrap {
  background:linear-gradient(150deg,var(--glass-surface),rgba(11,30,43,.8));
  border-top:1px solid var(--glass-border);
  -webkit-backdrop-filter:blur(13px);backdrop-filter:blur(13px);
  box-shadow:inset 0 1px var(--glass-highlight);
}
body[data-glass="on"][data-theme="light"] #seismo-wrap {
  background:linear-gradient(140deg,rgba(255,255,255,.84),rgba(223,242,249,.72));
}
body[data-glass="on"] .sb-tabs{background:rgba(255,255,255,.024);border-bottom-color:var(--glass-border)}
body[data-glass="on"][data-theme="light"] .sb-tabs{background:rgba(255,255,255,.35)}
body[data-glass="on"] .sb-tab.active{background:linear-gradient(0deg,rgba(94,224,192,.10),transparent 70%);text-shadow:0 0 13px rgba(94,224,192,.22)}
body[data-glass="on"] .sb-section{border-bottom-color:var(--glass-border)}
body[data-glass="on"] :is(.resp-card,.safety-card,.resp-stat,.quake-card,.history-summary > div) {
  background:linear-gradient(148deg,var(--glass-card),rgba(51,80,101,.23));
  border-color:var(--glass-border);
  box-shadow:inset 0 1px var(--glass-highlight),0 5px 15px rgba(0,0,0,.09);
  -webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px);
}
body[data-glass="on"][data-theme="light"] :is(.resp-card,.safety-card,.resp-stat,.quake-card,.history-summary > div) {
  background:linear-gradient(145deg,rgba(255,255,255,.78),rgba(225,243,253,.55));
  box-shadow:inset 0 1px rgba(255,255,255,.95),0 6px 18px rgba(25,70,95,.07);
}
body[data-glass="on"] :is(.resp-card,.quake-card):hover {
  border-color:var(--accent);
  box-shadow:inset 0 1px var(--glass-highlight),0 8px 21px rgba(38,159,152,.15);
}
body[data-glass="on"] .quake-card.selected{background:rgba(94,224,192,.17)}
body[data-glass="on"] :is(.hud-chip,.zbtn,.map-attribution,.map-loading,.info-hud,#inspector){
  background:var(--glass-hud);
  border:1px solid var(--glass-border);
  -webkit-backdrop-filter:blur(18px) saturate(145%);backdrop-filter:blur(18px) saturate(145%);
  box-shadow:0 10px 26px var(--glass-shadow),inset 0 1px var(--glass-highlight);
}
body[data-glass="on"] :is(.hud-chip,.info-hud,.map-attribution,.map-loading){color:var(--text-hi)}
/* Satellite view must retain legible, explicitly sourced labels. */
body[data-glass="on"] .info-hud{max-width:245px}
body[data-glass="on"] .info-hud strong{color:var(--text-hi)}
body[data-glass="on"] :is(.resp-input,.action-btn:not(.primary):not(.danger),.src-btn,.seg-btn,.map-layer-btn,.hist-refresh-btn){
  background:var(--glass-control);
  border-color:var(--glass-border);
  -webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px);
  box-shadow:inset 0 1px var(--glass-highlight);
}
body[data-glass="on"] .resp-input{
  background:var(--glass-input);
  color:var(--text-hi);
  border-color:var(--glass-border);
  -webkit-backdrop-filter:none;backdrop-filter:none;
  box-shadow:inset 0 1px rgba(255,255,255,.04);
}
body[data-glass="on"] .resp-input:focus-visible,
body[data-glass="on"] :is(.action-btn,.map-layer-btn,.sb-tab):focus-visible{outline:2px solid var(--accent);outline-offset:2px}
body[data-glass="on"] .action-btn:not(.primary):not(.danger){color:var(--text-hi)}
body[data-glass="on"] .action-btn.primary {box-shadow:0 3px 16px rgba(55,214,177,.20)}
body[data-glass="on"] #response-banner{background:var(--glass-surface-raised);border-color:var(--accent);color:var(--text-hi);-webkit-backdrop-filter:blur(18px);backdrop-filter:blur(18px)}
body[data-glass="on"] .resp-alert{background:rgba(220,128,37,.14);border-color:rgba(242,173,76,.4)}
body[data-glass="on"] .resp-chip{background:rgba(36,163,137,.14)}
/* Solid safety and critical status colors are intentional. */
body[data-glass="on"] .drill-watermark{background:rgba(80,39,9,.93);color:#ffe2b3}
body[data-glass="on"][data-theme="light"] .drill-watermark{background:rgba(255,245,226,.95);color:#874800}
.glass-switch {display:inline-flex;align-items:center;justify-content:center;gap:4px;min-width:99px}
.glass-switch .glass-symbol{font-size:15px;line-height:0;display:inline-flex;align-items:center}
.glass-switch[aria-pressed="true"]{border-color:var(--accent)!important;color:var(--accent)!important}
.glass-switch[aria-pressed="true"] .glass-symbol{filter:drop-shadow(0 0 5px rgba(94,224,192,.45))}
.glass-switch[aria-pressed="false"]{opacity:.9}
@media(max-width:1100px){.glass-switch{min-width:80px}}
@media(max-width:660px){.glass-switch{min-width:36px}.glass-switch .glass-label{display:none}.glass-switch .glass-symbol{font-size:17px}}
@media(max-width:420px){#glass-toggle{padding:7px 6px;min-width:35px;min-height:34px}}
/* Prefer functional clarity over translucency for high-contrast or low-transparency OS settings. */
@media (prefers-contrast:more),(prefers-reduced-transparency:reduce){
  body[data-glass="on"] #sidebar,body[data-glass="on"] #topbar,body[data-glass="on"] #seismo-wrap{background:var(--panel-solid);-webkit-backdrop-filter:none;backdrop-filter:none}
  body[data-glass="on"] :is(.resp-card,.safety-card,.resp-stat,.quake-card,.history-summary > div,.hud-chip,.info-hud){background:var(--panel-solid);-webkit-backdrop-filter:none;backdrop-filter:none}
}
@supports not ((backdrop-filter:blur(1px)) or (-webkit-backdrop-filter:blur(1px))){
  body[data-glass="on"] #topbar,body[data-glass="on"] #sidebar,body[data-glass="on"] #seismo-wrap{background:var(--panel-solid)}
  body[data-glass="on"] :is(.resp-card,.safety-card,.resp-stat,.quake-card,.hud-chip,.info-hud){background:var(--panel-solid)}
}

