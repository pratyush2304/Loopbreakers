const MAX_MERCATOR_LAT=85.05112878;
function project(lon,lat){
  const clampedLat=Math.max(-MAX_MERCATOR_LAT,Math.min(MAX_MERCATOR_LAT,lat));
  const phi=clampedLat*Math.PI/180;
  const normalY=(1-Math.log(Math.tan(phi)+1/Math.cos(phi))/Math.PI)/2;
  return {x:(lon+180)/360*mapW, y:(mapH-mapW)/2+normalY*mapW};
}

function worldToScreen(lon, lat){
  const p = project(lon, lat);
  const vp = state.viewport;
  return {
    x: p.x * vp.scale + vp.x,
    y: p.y * vp.scale + vp.y
  };
}

function kmPerPixelAtScale(scale){
  // Scale-bar approximation at the displayed center latitude, not the equator.
  const py=(mapH/2-state.viewport.y)/Math.max(scale,0.001);
  const normY=(py-(mapH-mapW)/2)/Math.max(mapW,1);
  const lat=Math.atan(Math.sinh(Math.PI*(1-2*normY)));
  return EARTH_CIRCUMFERENCE_KM*Math.max(.02,Math.cos(lat))/(mapW*scale);
}

