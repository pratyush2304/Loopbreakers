  const quakes=state.quakes.filter(q=>Number.isFinite(q.lat)&&Number.isFinite(q.lon));
  const ranked=quakes.map(q=>({quake:q,km:haversineKm(rescue.home.lat,rescue.home.lon,q.lat,q.lon)})).sort((a,b)=>a.km-b.km);
