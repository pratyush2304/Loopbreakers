  const z=Math.max(0,Math.min(17,Math.round(Math.log2(pixelsAcrossWorld/256))));
  const grid=2**z, tilePixels=pixelsAcrossWorld/grid;
  const left=vp.x,top=vp.y+(mapH-mapW)/2*vp.scale;
  const xMin=Math.max(0,Math.floor(-left/tilePixels)-1);
  const xMax=Math.min(grid-1,Math.ceil((mapW-left)/tilePixels)+1);
  const yMin=Math.max(0,Math.floor(-top/tilePixels)-1);
  const yMax=Math.min(grid-1,Math.ceil((mapH-top)/tilePixels)+1);
  let loaded=0,loading=0,failed=0;
  const visible=new Set();
  // Tiles are only requested for the current viewport (no bulk imagery download).
  for(let y=yMin;y<=yMax;y++){
    for(let x=xMin;x<=xMax;x++){
      const key=z+'/'+y+'/'+x;
      visible.add(key);
      let tile=satelliteTiles.get(key);
      if(!tile){
        const img=new Image();
        tile={img,status:'loading'};
        satelliteTiles.set(key,tile);
        img.onload=()=>{tile.status=img.naturalWidth>0?'loaded':'error';};
        img.onerror=()=>{tile.status='error';};
        img.src=TILE_ROOT+'/'+key;
