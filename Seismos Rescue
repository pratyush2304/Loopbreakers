    const p=worldToScreen(76.27,32.1);
    mapCtx.save();mapCtx.strokeStyle='#ff9933';mapCtx.lineWidth=2;mapCtx.setLineDash([4,5]);
    mapCtx.beginPath();mapCtx.arc(p.x,p.y,22+Math.sin(Date.now()/600)*4,0,Math.PI*2);mapCtx.stroke();
    mapCtx.setLineDash([]);mapCtx.fillStyle='#ffd3a5';mapCtx.font='bold 10px Consolas, monospace';
    mapCtx.fillText('SIMULATION M6.4',p.x+19,p.y-23);mapCtx.restore();
  }
  if(rescue.home){
    const p=worldToScreen(rescue.home.lon,rescue.home.lat);
    mapCtx.save();mapCtx.fillStyle='#6aa9ff';mapCtx.strokeStyle='#ffffff';mapCtx.lineWidth=2;
    mapCtx.beginPath();mapCtx.arc(p.x,p.y,5,0,Math.PI*2);mapCtx.fill();mapCtx.stroke();mapCtx.restore();
  }
}
async function rescueConnectServer(){
  const controller=new AbortController(),timer=setTimeout(()=>controller.abort(),2500);
  try{
    const res=await fetch('/api/health',{signal:controller.signal,cache:'no-store'});
    if(!res.ok)throw new Error('Backend health HTTP '+res.status);
    const data=await res.json();
    if(data.service!=='seismos-rescue-demo')throw new Error('Invalid response from API');
    if(data.ready===false)throw new Error(data.error||'Database is not initialized');
    rescue.mode='shared';rescue.apiReady=true;rescue.syncMode=data.sync||'sse';
    await rescueRefreshSession();
  }catch(err){if(location.protocol!=='file:'&&!['localhost','127.0.0.1'].includes(location.hostname)){rescue.mode='unavailable';rescueToast('Shared backend unavailable; incident submission disabled.',true);}else if(rescue.mode==='shared')rescueToast('Server unavailable: '+err.message,true);}
  finally{clearTimeout(timer);rescueRenderAuth();rescueRender();}
}
async function rescueLoadAudit(){
  if(rescue.user?.role!=='responder')return;
  try{
    const data=await rescueApi('/api/audit'),list=$('#audit-list');list.textContent='';
    for(const entry of data.events.slice(0,18)){
      const row=document.createElement('div');row.className='audit-entry';
      row.textContent=new Date(entry.at).toLocaleString()+' · '+entry.actor+' · '+entry.action+(entry.details?' · '+entry.details:'');
      list.appendChild(row);
    }
    if(!data.events.length)list.textContent='No changes recorded yet.';
  }catch(err){rescueToast('Audit unavailable: '+err.message,true);}
}

