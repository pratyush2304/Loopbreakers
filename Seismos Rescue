function rescueHitTest(mx,my){
  let best=null,d=Infinity;
  for(const x of rescue.incidents){
    if(!Number.isFinite(Number(x.lat))||!Number.isFinite(Number(x.lon)))continue;
    const pt=worldToScreen(Number(x.lon),Number(x.lat));
    const distance=Math.hypot(mx-pt.x,my-pt.y);
    if(distance<12&&distance<d){best=x;d=distance;}
  }
  return best;
}
