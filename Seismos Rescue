<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="theme-color" content="#05070a">
<link rel="manifest" href="/manifest.webmanifest">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>SEISMOS Rescue — Satellite Map + Emergency Response</title>
<style>
  :root{
    --bg-0:#05070a;
    --bg-1:#0a0e14;
    --bg-2:#0f1420;
    --panel:rgba(15,20,32,0.55);
    --panel-solid:#0d1119;
    --border:rgba(255,255,255,0.08);
    --border-bright:rgba(120,200,255,0.25);
    --text-hi:#e8edf5;
    --text-mid:#94a3b8;
    --text-low:#4b5768;
    --accent:#5ee0c0;
    --accent-dim:#2a7d6b;
    --green:#3ddc84;
    --yellow:#f2c94c;
    --red:#ff5c5c;
    --deep:#7c8fff;
    --p-wave:#5ee0c0;
    --s-wave:#ff8a5c;
    --saffron:#ff9933;
    --mono:'SF Mono','Cascadia Code','Consolas',monospace;
    --sans:-apple-system,BlinkMacSystemFont,'Segoe UI',Inter,Roboto,sans-serif;
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  html,body{
    width:100%; height:100%; overflow:hidden;
    background:var(--bg-0);
    font-family:var(--sans);
    color:var(--text-hi);
    -webkit-font-smoothing:antialiased;
  }
  #app{
    display:grid;
    grid-template-columns: 1fr 380px;
    grid-template-rows: 56px 1fr 190px;
    grid-template-areas:
      "topbar topbar"
      "canvas sidebar"
      "seismo sidebar";
    width:100vw; height:100vh;
    gap:1px;
    background:var(--bg-0);
  }

  /* ===== Top bar ===== */
  #topbar{
    grid-area: topbar;
    display:flex; align-items:center; justify-content:space-between;
    padding:0 18px;
    background:linear-gradient(180deg, rgba(20,26,38,0.9), rgba(12,16,24,0.7));
    border-bottom:1px solid var(--border);
    backdrop-filter: blur(14px);
    z-index:20;
  }
  .brand{ display:flex; align-items:center; gap:10px; }
  .brand-mark{
    width:26px; height:26px; position:relative; flex-shrink:0;
  }
  .brand-mark svg{ width:100%; height:100%; }
  .brand-text{ display:flex; flex-direction:column; line-height:1; }
  .brand-text b{ font-size:14.5px; letter-spacing:0.02em; font-weight:700; }
  .brand-text span{ font-size:9.5px; color:var(--text-low); letter-spacing:0.14em; text-transform:uppercase; margin-top:3px; }

  .topbar-stats{ display:flex; gap:22px; align-items:center; }
  .tstat{ display:flex; flex-direction:column; align-items:flex-end; line-height:1.1; }
  .tstat .v{ font-family:var(--mono); font-size:15px; font-weight:600; color:var(--text-hi); }
  .tstat .l{ font-size:9px; color:var(--text-low); text-transform:uppercase; letter-spacing:0.1em; margin-top:2px;}
  .status-dot{ width:7px; height:7px; border-radius:50%; background:var(--green); box-shadow:0 0 8px var(--green); }
  .status-dot.warn{ background:var(--yellow); box-shadow:0 0 8px var(--yellow); }
  .status-dot.err{ background:var(--red); box-shadow:0 0 8px var(--red); }
  .status-wrap{ display:flex; align-items:center; gap:7px; font-size:11px; color:var(--text-mid); font-family:var(--mono); }
  .pulse{ animation:pulseDot 2s ease-in-out infinite; }
  @keyframes pulseDot{ 0%,100%{opacity:1;} 50%{opacity:0.35;} }

  .source-toggle{ display:flex; gap:5px; margin-left:6px; }
  .src-btn{
    padding:5px 10px; font-size:10px; font-family:var(--mono); font-weight:700;
    background:rgba(255,255,255,0.03); border:1px solid var(--border);
    border-radius:7px; color:var(--text-mid); cursor:pointer; letter-spacing:0.04em;
    transition:all 0.15s;
  }
  .src-btn:hover{ border-color:var(--border-bright); color:var(--text-hi); }
  .src-btn.active{ background:rgba(255,153,51,0.14); border-color:var(--saffron); color:var(--saffron); }
  .src-btn.active.global{ background:rgba(94,224,192,0.14); border-color:var(--accent); color:var(--accent); }

  /* ===== Canvas area ===== */
  #canvas-wrap{
    grid-area: canvas;
    position:relative;
    overflow:hidden;
    background:
      radial-gradient(ellipse at 30% 20%, rgba(94,224,192,0.05), transparent 55%),
      radial-gradient(ellipse at 80% 80%, rgba(124,143,255,0.06), transparent 55%),
      var(--bg-1);
  }
  #mapCanvas{ position:absolute; inset:0; width:100%; height:100%; cursor:grab; }
  #mapCanvas.dragging{ cursor:grabbing; }

  .map-hud{
    position:absolute; top:12px; left:12px;
    display:flex; flex-direction:column; gap:8px;
    pointer-events:none;
    z-index:5;
  }
  .hud-chip{
    pointer-events:auto;
    background:var(--panel);
    border:1px solid var(--border);
    backdrop-filter:blur(12px);
    border-radius:10px;
    padding:8px 12px;
    font-size:10.5px;
    color:var(--text-mid);
    font-family:var(--mono);
    letter-spacing:0.02em;
  }
  .legend-row{ display:flex; align-items:center; gap:7px; margin-top:5px; }
  .legend-row:first-child{ margin-top:0; }
  .legend-dot{ width:9px; height:9px; border-radius:50%; flex-shrink:0; }
  .legend-line{ width:14px; height:0; border-top:2px dashed; flex-shrink:0; }

  .zoom-controls{
    position:absolute; bottom:14px; left:12px;
    display:flex; flex-direction:column; gap:6px;
    z-index:5;
  }
  .zbtn{
    width:34px; height:34px;
    background:var(--panel);
    border:1px solid var(--border);
    backdrop-filter:blur(12px);
    border-radius:9px;
    color:var(--text-hi);
    font-size:16px;
    display:flex; align-items:center; justify-content:center;
    cursor:pointer;
    user-select:none;
    transition:background 0.15s, border-color 0.15s;
  }
  .zbtn:hover{ background:rgba(94,224,192,0.12); border-color:var(--border-bright); }
  .zbtn:active{ transform:scale(0.94); }

  .scale-bar{
    position:absolute; bottom:14px; right:14px;
    z-index:5;
    display:flex; flex-direction:column; align-items:flex-end; gap:4px;
    pointer-events:none;
  }
  .scale-line{ height:2px; background:var(--text-mid); position:relative; }
  .scale-line::before, .scale-line::after{
    content:''; position:absolute; top:-4px; width:2px; height:10px; background:var(--text-mid);
  }
  .scale-line::before{ left:0; } .scale-line::after{ right:0; }
  .scale-label{ font-family:var(--mono); font-size:9.5px; color:var(--text-low); }

  /* tooltip / inspector */
  #inspector{
    position:absolute; z-index:30;
    background:var(--panel-solid);
    border:1px solid var(--border-bright);
    border-radius:12px;
    padding:14px 16px;
    width:250px;
    box-shadow:0 12px 40px rgba(0,0,0,0.5), 0 0 0 1px rgba(94,224,192,0.08);
    backdrop-filter:blur(20px);
    display:none;
    pointer-events:none;
  }
  #inspector.show{ display:block; }
  #inspector .insp-mag{
    font-family:var(--mono); font-size:26px; font-weight:700; line-height:1;
  }
  #inspector .insp-place{ font-size:12.5px; color:var(--text-hi); margin-top:6px; line-height:1.35; font-weight:600;}
  #inspector .insp-meta{ margin-top:10px; display:flex; flex-direction:column; gap:5px; }
  .insp-row{ display:flex; justify-content:space-between; font-size:11px; font-family:var(--mono); }
  .insp-row span:first-child{ color:var(--text-low); text-transform:uppercase; letter-spacing:0.06em; font-size:9.5px;}
  .insp-row span:last-child{ color:var(--text-mid); }
  .insp-tag{
    display:inline-block; margin-top:10px; padding:3px 9px; border-radius:20px;
    font-size:9.5px; font-weight:700; letter-spacing:0.06em; text-transform:uppercase;
    font-family:var(--mono);
  }

  /* ===== Sidebar ===== */
  #sidebar{
    grid-area: sidebar;
    background:linear-gradient(180deg, rgba(13,17,26,0.85), rgba(10,13,20,0.9));
    border-left:1px solid var(--border);
    backdrop-filter:blur(16px);
    display:flex; flex-direction:column;
    overflow:hidden;
    z-index:15;
  }
  .sb-tabs{
    display:flex; border-bottom:1px solid var(--border); flex-shrink:0;
  }
  .sb-tab{
    flex:1; text-align:center; padding:11px 4px;
    font-size:10.5px; font-family:var(--mono); font-weight:700;
    letter-spacing:0.05em; text-transform:uppercase;
    color:var(--text-low); cursor:pointer; border-bottom:2px solid transparent;
    transition:all 0.15s;
  }
  .sb-tab:hover{ color:var(--text-mid); }
  .sb-tab.active{ color:var(--accent); border-bottom-color:var(--accent); }
  .sb-panel{ display:none; flex:1; flex-direction:column; overflow:hidden; }
  .sb-panel.active{ display:flex; }

  .sb-section{
    padding:14px 16px;
    border-bottom:1px solid var(--border);
  }
  .sb-title{
    font-size:10px; text-transform:uppercase; letter-spacing:0.12em;
    color:var(--text-low); font-weight:700; margin-bottom:10px;
    display:flex; align-items:center; justify-content:space-between;
  }
  .sb-title .count{
    font-family:var(--mono); color:var(--accent); font-size:10.5px;
    background:rgba(94,224,192,0.1); padding:2px 7px; border-radius:20px;
  }

  /* filter controls */
  .filter-row{ display:flex; flex-direction:column; gap:6px; margin-bottom:12px; }
  .filter-row:last-child{ margin-bottom:0; }
  .filter-label{
    display:flex; justify-content:space-between; font-size:11px; color:var(--text-mid);
  }
  .filter-label b{ color:var(--text-hi); font-family:var(--mono); font-weight:600; }
  input[type="range"]{
    -webkit-appearance:none; appearance:none;
    width:100%; height:4px; border-radius:2px;
    background:linear-gradient(90deg, var(--accent-dim), var(--border));
    outline:none; cursor:pointer;
  }
  input[type="range"]::-webkit-slider-thumb{
    -webkit-appearance:none; appearance:none;
    width:14px; height:14px; border-radius:50%;
    background:var(--accent);
    box-shadow:0 0 0 3px rgba(94,224,192,0.18), 0 2px 6px rgba(0,0,0,0.4);
    cursor:pointer; border:2px solid #06110d;
  }
  input[type="range"]::-moz-range-thumb{
    width:14px; height:14px; border-radius:50%;
    background:var(--accent); border:2px solid #06110d; cursor:pointer;
  }

  .seg-control{ display:flex; gap:5px; }
  .seg-btn{
    flex:1; text-align:center; padding:6px 4px;
    font-size:10.5px; font-family:var(--mono); font-weight:600;
    background:rgba(255,255,255,0.03); border:1px solid var(--border);
    border-radius:7px; color:var(--text-mid); cursor:pointer;
    transition:all 0.15s;
  }
  .seg-btn:hover{ border-color:var(--border-bright); color:var(--text-hi); }
  .seg-btn.active{
    background:rgba(94,224,192,0.14); border-color:var(--accent); color:var(--accent);
  }

  /* feed */
  #feed-section{
    flex:1; display:flex; flex-direction:column; overflow:hidden; padding-bottom:0;
  }
  #feed-list{
    flex:1; overflow-y:auto; overflow-x:hidden;
    padding:6px 10px 10px;
  }
  #feed-list::-webkit-scrollbar{ width:6px; }
  #feed-list::-webkit-scrollbar-track{ background:transparent; }
  #feed-list::-webkit-scrollbar-thumb{ background:rgba(255,255,255,0.08); border-radius:4px; }

  .quake-card{
    display:flex; align-items:center; gap:10px;
    padding:9px 10px; margin-bottom:6px;
    background:rgba(255,255,255,0.02);
    border:1px solid var(--border);
    border-left:3px solid var(--text-low);
    border-radius:8px;
    cursor:pointer;
    transition:background 0.15s, border-color 0.15s, transform 0.15s;
    animation: cardIn 0.35s ease-out;
  }
  @keyframes cardIn{ from{ opacity:0; transform:translateY(-6px);} to{opacity:1; transform:translateY(0);} }
  .quake-card:hover{ background:rgba(94,224,192,0.06); border-color:var(--border-bright); transform:translateX(2px); }
  .quake-card.selected{ background:rgba(94,224,192,0.1); border-color:var(--accent); }
  .quake-card.green{ border-left-color:var(--green); }
  .quake-card.yellow{ border-left-color:var(--yellow); }
  .quake-card.red{ border-left-color:var(--red); }

  .qc-mag{
    width:40px; height:40px; border-radius:9px; flex-shrink:0;
    display:flex; align-items:center; justify-content:center;
    font-family:var(--mono); font-weight:700; font-size:14px;
    background:rgba(255,255,255,0.04);
  }
  .qc-mag.green{ color:var(--green); box-shadow:inset 0 0 0 1px rgba(61,220,132,0.35); }
  .qc-mag.yellow{ color:var(--yellow); box-shadow:inset 0 0 0 1px rgba(242,201,76,0.35); }
  .qc-mag.red{ color:var(--red); box-shadow:inset 0 0 0 1px rgba(255,92,92,0.4); }

  .qc-body{ flex:1; min-width:0; }
  .qc-place{
    font-size:11.5px; font-weight:600; color:var(--text-hi);
    white-space:nowrap; overflow:hidden; text-overflow:ellipsis;
  }
  .qc-meta{
    display:flex; gap:8px; margin-top:3px;
    font-size:9.5px; color:var(--text-low); font-family:var(--mono);
  }
  .qc-time{ font-size:9.5px; color:var(--text-low); font-family:var(--mono); flex-shrink:0; text-align:right;}

  .empty-state{
    display:flex; flex-direction:column; align-items:center; justify-content:center;
    padding:40px 20px; color:var(--text-low); text-align:center; gap:8px;
  }
  .empty-state svg{ opacity:0.3; width:32px; height:32px; }
  .empty-state span{ font-size:11px; }

  /* ===== History panel ===== */
  #history-panel{ overflow-y:auto; }
  #history-panel::-webkit-scrollbar{ width:6px; }
  #history-panel::-webkit-scrollbar-thumb{ background:rgba(255,255,255,0.08); border-radius:4px; }
  .hist-note{
    font-size:10.5px; color:var(--text-low); line-height:1.5; padding:0 0 12px;
  }
  .hist-refresh-btn{
    margin-top:8px; width:100%; padding:8px; text-align:center;
    background:rgba(255,153,51,0.1); border:1px solid rgba(255,153,51,0.3);
    border-radius:8px; color:var(--saffron); font-family:var(--mono);
    font-size:10.5px; font-weight:700; cursor:pointer; letter-spacing:0.04em;
    transition:background 0.15s;
  }
  .hist-refresh-btn:hover{ background:rgba(255,153,51,0.18); }
  .hist-refresh-btn.loading{ opacity:0.5; pointer-events:none; }

  .state-row{
    display:flex; align-items:center; gap:10px;
    padding:8px 0; border-bottom:1px solid rgba(255,255,255,0.04);
  }
  .state-row:last-child{ border-bottom:none; }
  .state-rank{
    width:18px; font-family:var(--mono); font-size:9.5px; color:var(--text-low); flex-shrink:0;
  }
  .state-name{
    flex:1; font-size:11px; color:var(--text-hi); font-weight:600;
    white-space:nowrap; overflow:hidden; text-overflow:ellipsis;
  }
  .state-bar-track{
    height:5px; border-radius:3px; background:rgba(255,255,255,0.05);
    overflow:hidden; margin-top:4px;
  }
  .state-bar-fill{
    height:100%; border-radius:3px;
    background:linear-gradient(90deg, var(--accent-dim), var(--saffron));
  }
  .state-stats{ display:flex; flex-direction:column; align-items:flex-end; flex-shrink:0; gap:2px; }
  .state-maxmag{
    font-family:var(--mono); font-size:12.5px; font-weight:700;
  }
  .state-count{ font-family:var(--mono); font-size:9px; color:var(--text-low); }
  .state-col{ flex:1; min-width:0; }

  /* ===== Seismograph HUD ===== */
  #seismo-wrap{
    grid-area: seismo;
    position:relative;
    background:linear-gradient(180deg, rgba(10,13,20,0.9), rgba(7,9,14,0.95));
    border-top:1px solid var(--border);
    overflow:hidden;
  }
  #seismoCanvas{ position:absolute; inset:0; width:100%; height:100%; }
  .seismo-label{
    position:absolute; top:10px; left:16px; z-index:2;
    font-family:var(--mono); font-size:10px; color:var(--text-low);
    text-transform:uppercase; letter-spacing:0.1em;
    display:flex; align-items:center; gap:8px;
  }
  .seismo-label .rec-dot{
    width:6px; height:6px; border-radius:50%; background:var(--red);
    box-shadow:0 0 6px var(--red); animation:pulseDot 1.4s ease-in-out infinite;
  }
  .seismo-readout{
    position:absolute; top:10px; right:16px; z-index:2;
    font-family:var(--mono); font-size:10px; color:var(--text-mid);
    text-align:right; line-height:1.5;
  }
  .seismo-readout b{ color:var(--accent); }


  /* Historical catalog: provenance, coverage and actionable loading states. */
  .history-summary { display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:6px;margin:0 0 10px; }
  .history-summary > div {background:rgba(94,224,192,.045);border:1px solid rgba(94,224,192,.12);border-radius:9px;padding:10px 7px;min-width:0;}
  .history-summary span {display:block;color:var(--text-low);font:9px var(--mono);text-transform:uppercase;letter-spacing:.04em;margin-bottom:6px;}
  .history-summary b {display:block;color:var(--text-hi);font:600 12px var(--mono);overflow-wrap:anywhere;}
  .history-status {font-size:11px;line-height:1.6;color:var(--accent);padding:9px 11px;border:1px solid rgba(94,224,192,.22);border-radius:8px;background:rgba(94,224,192,.06);margin-bottom:12px;overflow-wrap:anywhere;}
  .history-status.warn {color:#f2c94c;background:rgba(242,201,76,.06);border-color:rgba(242,201,76,.25);}
  .history-status.error {color:#ff9999;background:rgba(255,92,92,.07);border-color:rgba(255,92,92,.25);}
  .history-status.loading {color:#a8c9fa;background:rgba(98,152,241,.06);border-color:rgba(98,152,241,.2);}
  #history-panel .state-row {padding:10px 0;}
  #history-panel #state-list {min-height:64px;}
  #history-panel .hist-refresh-btn {display:block;min-height:44px;}
  #history-panel .hist-refresh-btn.loading {cursor:wait;opacity:.75;}

  /* responsive */
  @media (max-width: 860px){
    #app{
      grid-template-columns: 1fr;
      grid-template-rows: 52px 1fr 160px 260px;
      grid-template-areas:
        "topbar"
        "canvas"
        "seismo"
        "sidebar";
    }
    .topbar-stats{ display:none; }
  }

  ::selection{ background:rgba(94,224,192,0.3); }

  #loading-overlay{
    position:absolute; inset:0; z-index:50;
    background:var(--bg-1);
    display:flex; flex-direction:column; align-items:center; justify-content:center;
    gap:14px;
    transition:opacity 0.5s ease;
  }
  .loader-ring{
    width:40px; height:40px; border-radius:50%;
    border:2px solid rgba(94,224,192,0.15);
    border-top-color:var(--accent);
    animation:spin 0.9s linear infinite;
  }
  @keyframes spin{ to{ transform:rotate(360deg); } }
  #loading-overlay span{ font-family:var(--mono); font-size:11px; color:var(--text-low); letter-spacing:0.08em; text-transform:uppercase;}

  #boot-banner{
    position:fixed; top:0; left:0; right:0; z-index:9999;
    background:#3a1010; border-bottom:1px solid rgba(255,92,92,0.4);
    color:#ffb4b4; font-family:var(--mono); font-size:12px;
    padding:10px 16px; display:none; line-height:1.5;
  }
  #boot-banner a{ color:#ff9933; }
  #boot-banner.show{ display:block; }

  @media (prefers-reduced-motion: reduce){
    *{ animation-duration:0.001ms !important; animation-iteration-count:1 !important; transition-duration:0.001ms !important; }
  }
/* SEISMOS RESCUE / hackathon extension. Original visualizer styling preserved. */
:root { --response-glow:#65e2c4; }
.topbar-actions {display:flex;align-items:center;gap:7px;margin-left:12px}
.action-btn {font:700 10px var(--mono);padding:9px 11px;border-radius:8px;border:1px solid rgba(94,224,192,.28);color:#ccefe6;background:rgba(94,224,192,.08);cursor:pointer;white-space:nowrap;transition:.15s}
.action-btn:hover,.action-btn:focus-visible {background:rgba(94,224,192,.20);outline:1px solid rgba(94,224,192,.45)}
.action-btn.primary {background:#49d4b1;color:#081612;border-color:#49d4b1}
.action-btn.danger {background:rgba(255,92,92,.10);border-color:rgba(255,92,92,.5);color:#ffaaaa}
.action-btn:disabled {opacity:.5;cursor:not-allowed}
.sb-tab {font-size:9.6px;padding:12px 3px}
.sb-panel#panel-response, .sb-panel#panel-safety {overflow-y:auto;padding-bottom:18px;scrollbar-width:thin}
.resp-note {font-size:10.5px;line-height:1.55;color:#aabbd0}
.resp-note a {color:#5ee0c0}
.resp-alert {padding:10px 12px;background:rgba(255,153,51,.09);border:1px solid rgba(255,153,51,.28);border-radius:9px;font-size:10.5px;line-height:1.5;color:#ffd4a4}
.resp-data {display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:7px}
.resp-stat {padding:10px 5px;background:rgba(255,255,255,.035);border:1px solid var(--border);border-radius:9px;text-align:center}
.resp-stat b {font:700 21px var(--mono);display:block;color:#e6f9f5}
.resp-stat span {font-size:9px;color:var(--text-mid)}
.resp-field {display:flex;flex-direction:column;gap:5px;min-width:0}
.resp-field label {font-size:10px;color:#bbcce0;font-weight:600}
.resp-input {width:100%;min-width:0;color:#e5eef6;background:#101826;border:1px solid rgba(148,163,184,.25);border-radius:8px;padding:9px;font:11px var(--sans);outline:none}
.resp-input:focus {border-color:#5ee0c0;box-shadow:0 0 0 2px rgba(94,224,192,.1)}
textarea.resp-input{resize:vertical;min-height:65px}
.resp-grid-two {display:grid;grid-template-columns:1fr 1fr;gap:8px}
.resp-stack {display:flex;flex-direction:column;gap:9px}
.resp-row {display:flex;align-items:center;gap:7px;flex-wrap:wrap}
.resp-row.between{justify-content:space-between}
.resp-row button {min-width:0}
.resp-chip{font:700 9px var(--mono);border:1px solid rgba(94,224,192,.3);padding:4px 7px;border-radius:6px;background:rgba(94,224,192,.07);color:#80e5cc}
.resp-chip.demo {color:#ffc17f;border-color:rgba(255,153,51,.35);background:rgba(255,153,51,.08)}
.resp-chip.critical {color:#ffb1b1;border-color:rgba(255,92,92,.3);background:rgba(255,92,92,.1)}
.resp-card {background:#111924;border:1px solid rgba(255,255,255,.08);border-radius:10px;padding:10px;margin-bottom:8px}
.resp-card .title {font-weight:700;font-size:11.5px;color:#f1f5fa}
.resp-card .meta {font:10px var(--mono);color:#8da0b7;margin-top:5px;line-height:1.5}
.resp-card .desc {font-size:10.5px;color:#c2cee1;margin:8px 0;white-space:pre-wrap;overflow-wrap:anywhere}
.resp-card .action-btn {padding:7px 9px}
.resp-card:hover {border-color:rgba(94,224,192,.3)}
.resp-empty {text-align:center;padding:24px 8px;color:#8191a6;font-size:11px;line-height:1.6}
.resp-message {font-size:10.5px;color:#5ee0c0;line-height:1.45;min-height:16px}
.resp-message.error {color:#ff9090}
.loc-readout{font:10px var(--mono);color:#a8bacd;line-height:1.55}
.info-hud{position:absolute;right:12px;top:12px;z-index:7;pointer-events:none;max-width:235px;background:rgba(9,15,24,.86);border:1px solid rgba(94,224,192,.17);border-radius:9px;padding:10px 12px;backdrop-filter:blur(12px);font:10px var(--mono);color:#adbed1;line-height:1.5}
.info-hud strong{display:block;color:#dceee7;margin-bottom:3px}
.info-hud .data-age{color:#ffbd7d}
.drill-watermark{position:absolute;left:50%;top:14px;transform:translateX(-50%);z-index:6;background:rgba(250,153,51,.16);border:1px solid rgba(255,153,51,.55);padding:8px 13px;border-radius:8px;font:700 11px var(--mono);letter-spacing:.05em;color:#ffd09b;pointer-events:none;white-space:nowrap}
.safety-card{border:1px solid rgba(255,255,255,.1);border-radius:10px;padding:12px;background:rgba(255,255,255,.025);font-size:11px;color:#bed0dc;line-height:1.6}
.safety-card h3{font-size:12px;color:#e3f6ed;margin-bottom:6px}
.safety-card p {margin:0 0 8px}
.safety-card p:last-child {margin-bottom:0}
.safety-card a{color:#5ee0c0}
.safety-card ol,.safety-card ul{padding-left:18px;margin-top:6px}
.safety-card li{margin-bottom:4px}
.safety-call{display:flex;justify-content:center;gap:10px;align-items:center;text-decoration:none;color:#081612;font-weight:800;letter-spacing:.04em;background:#5ee0c0;padding:11px;border-radius:9px}
.safety-call:hover {background:#8af6dc}
#response-nearby {font:10.5px var(--mono);line-height:1.55;color:#aac5cb;min-height:25px}
#data-timestamp {font:9.5px var(--mono);color:#a1bbce}
#response-banner{position:fixed;bottom:12px;left:50%;transform:translateX(-50%);z-index:150;background:#132e2d;border:1px solid #5ee0c0;color:#e9f5f1;padding:10px 16px;border-radius:9px;font-size:12px;box-shadow:0 12px 42px rgba(0,0,0,.3);max-width:90vw;display:none}
#response-banner.show {display:block}
#panel-response::-webkit-scrollbar, #panel-safety::-webkit-scrollbar {width:5px}
#panel-response::-webkit-scrollbar-thumb, #panel-safety::-webkit-scrollbar-thumb{background:rgba(255,255,255,.15)}
@media (max-width:1100px) { .topbar-stats{gap:8px}.tstat{display:none}.info-hud{top:auto;bottom:10px;max-width:200px}.brand-text span{font-size:8px}}
@media (max-width:860px) {.topbar-actions{margin-left:auto;gap:4px}.action-btn{padding:7px;font-size:9px}.info-hud{font-size:9px;bottom:9px;right:7px}.map-hud{top:7px;left:7px}.hud-chip{font-size:9px;padding:7px}.drill-watermark{top:5px;font-size:9px}.sb-tab{font-size:10px}}
@media (max-width:860px){#app{grid-template-rows:52px minmax(165px,36vh) minmax(0,1fr);grid-template-areas:"topbar" "canvas" "sidebar"}#seismo-wrap{display:none}}
@media (max-width:420px){.topbar-actions .quiet-action{display:none}.brand-text span{display:none}}

/* SEISMOS satellite basemap + dual appearance (new, scoped overrides) */
body[data-theme="light"]{
  --bg-0:#edf3f8;--bg-1:#eaf1f6;--bg-2:#dce9f0;
  --panel:rgba(255,255,255,.94);--panel-solid:#fff;
  --border:rgba(29,59,78,.17);--border-bright:rgba(0,128,117,.42);
  --text-hi:#152d40;--text-mid:#40566a;--text-low:#627789;
  --accent:#087f76;--accent-dim:#17a18d;--green:#087c4b;
  --yellow:#98640b;--red:#b4313e;--deep:#4056b5;
  --p-wave:#0d8f83;--s-wave:#d06d31;
}
body[data-theme="light"] #topbar{background:linear-gradient(180deg,rgba(255,255,255,.97),rgba(237,245,249,.94))}
body[data-theme="light"] #sidebar{background:linear-gradient(180deg,#fff,#f3f8fb)}
