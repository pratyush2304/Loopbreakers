/* =========================================================================
   DATA NORMALIZATION
   ========================================================================= */
function normalizeFeature(f){
  const [lon, lat, depth] = f.geometry.coordinates;
  const p = f.properties;
  const mag = p.mag == null ? 0 : p.mag;
  let alertLevel;
  if (mag >= 6.0) alertLevel = "red";
  else if (mag >= 4.5) alertLevel = "yellow";
  else alertLevel = "green";
  return {
    id: f.id,
    lon, lat, depth: depth == null ? 0 : depth,
    mag,
    place: p.place || "Unknown location",
    time: p.time || Date.now(),
    alertLevel,
    url: p.url || null,
    magType: p.magType || "—",
    _bornAt: performance.now(),
  };
}

/* Normalize an NCS-style record if/when that endpoint ever responds.
   NCS fields vary by release; this defensively reads a handful of common
   shapes (lat/lon/mag/depth/time/place) so a future working endpoint just
   works without further edits. */
function normalizeNcsRecord(r){
  const lat = parseFloat(r.lat ?? r.latitude ?? r.Latitude);
  const lon = parseFloat(r.lon ?? r.long ?? r.longitude ?? r.Longitude);
  const mag = parseFloat(r.mag ?? r.magnitude ?? r.Magnitude);
  const depth = parseFloat(r.depth ?? r.Depth ?? 10);
  const place = r.place ?? r.location ?? r.Location ?? r.region ?? "India region";
  let t = r.time ?? r.origin_time ?? r.datetime ?? r.Date_Time;
  let ts = Date.now();
  if (t){
    const parsed = Date.parse(t);
    if (!isNaN(parsed)) ts = parsed;
  }
  if (isNaN(lat) || isNaN(lon) || isNaN(mag)) return null;
  let alertLevel = mag >= 6.0 ? "red" : mag >= 4.5 ? "yellow" : "green";
  return {
    id: "ncs-" + (r.id ?? lat + "_" + lon + "_" + ts),
    lon, lat, depth: isNaN(depth) ? 10 : depth,
    mag, place, time: ts, alertLevel,
    url: null, magType: r.magType ?? "ML",
    _bornAt: performance.now(),
  };
}

/* =========================================================================
   DATA FETCH — GLOBAL (USGS all_day) vs INDIA (NCS attempt -> USGS bbox fallback)
   ========================================================================= */
async function fetchQuakes(){
  setStatus("connecting");
  if (state.source === "india"){
    await fetchIndiaQuakes();
  } else {
    await fetchGlobalQuakes();
  }
  state.lastFetch = performance.now();
  state.nextPollIn = POLL_INTERVAL_MS/1000;
  hideLoading();
}

async function fetchGlobalQuakes(){
  try{
    const timeoutPromise = new Promise((_, reject) => {
      setTimeout(() => reject(new Error("Request timed out")), 12000);
    });
    const res = await Promise.race([
      fetch(USGS_URL, { cache: "no-store" }),
      timeoutPromise
    ]);
    if (!res.ok) throw new Error("HTTP " + res.status);
    const json = await res.json();
    if (!json.features || !Array.isArray(json.features)) throw new Error("Malformed payload");
    ingestFeatures(json.features, "live");
  }catch(err){
    console.warn("[Seismos] Global live feed failed, using mock dataset:", err.message);
    if (state.quakes.length === 0){
      ingestFeatures(buildMockDataset(), "mock");
    } else {
      setStatus("error");
    }
  }
}

async function fetchIndiaQuakes(){
  // 1. Try NCS candidate endpoint(s) first — will very likely fail due to
  //    CORS since NCS does not publish a documented cross-origin JSON API.
  for (const url of NCS_CANDIDATE_URLS){
    try{
      const timeoutPromise = new Promise((_, reject) => setTimeout(()=>reject(new Error("timeout")), 6000));
      const res = await Promise.race([ fetch(url, { cache:"no-store" }), timeoutPromise ]);
      if (!res.ok) throw new Error("HTTP " + res.status);
      const data = await res.json();
      const records = Array.isArray(data) ? data : (data.data || data.records || data.earthquakes || []);
      const normalized = records.map(normalizeNcsRecord).filter(Boolean);
      if (normalized.length){
        ingestNormalized(normalized, "live-ncs");
        return;
      }
      throw new Error("Empty NCS payload");
    }catch(err){
      console.warn("[Seismos] NCS endpoint unavailable (" + url + "):", err.message);
    }
  }

  // 2. Fallback: USGS global catalog, scoped to India's bounding box.
  //    Same underlying open data, just filtered — this reliably works.
  try{
    const params = new URLSearchParams({
      format: "geojson",
      starttime: isoDaysAgo(1),
      endtime: new Date().toISOString(),
      minlatitude: INDIA_BBOX.minLat, maxlatitude: INDIA_BBOX.maxLat,
      minlongitude: INDIA_BBOX.minLon, maxlongitude: INDIA_BBOX.maxLon,
      minmagnitude: 0,
    });
    const url = USGS_QUERY_BASE + "?" + params.toString();
    const timeoutPromise = new Promise((_, reject) => setTimeout(()=>reject(new Error("timeout")), 12000));
    const res = await Promise.race([ fetch(url, { cache:"no-store" }), timeoutPromise ]);
    if (!res.ok) throw new Error("HTTP " + res.status);
    const json = await res.json();
    if (!json.features || !Array.isArray(json.features)) throw new Error("Malformed payload");
    if (json.features.length === 0){
      // No quakes in India bbox in the last 24h is common and fine —
      // show empty live state rather than falling back to mock.
      ingestFeatures([], "live");
      return;
    }
    ingestFeatures(json.features, "live");
  }catch(err){
    console.warn("[Seismos] India (USGS bbox) feed failed, using mock dataset:", err.message);
    if (state.quakes.length === 0){
      ingestFeatures(buildMockIndiaDataset(), "mock");
    } else {
      setStatus("error");
    }
  }
}

function isoDaysAgo(days){
  return new Date(Date.now() - days*86400000).toISOString();
}

function ingestFeatures(features, mode){
  ingestNormalized(features.map(normalizeFeature), mode);
}

function ingestNormalized(normalized, mode){
  const existingIds = new Set(state.quakes.map(q=>q.id));
  normalized = normalized.slice().sort((a,b)=> b.time - a.time);

  const freshOnes = normalized.filter(q => !existingIds.has(q.id));

  state.quakes = normalized;
  state.totalEvents = normalized.length;
  state.maxMag = normalized.reduce((m,q)=>Math.max(m, q.mag||0), 0);

  freshOnes.forEach(q=>{
    if (mode === "live" || mode === "live-ncs") triggerSeismoPulse(q.mag);
  });
  if (mode === "mock" && state.connectionStatus !== "mock"){
    normalized.slice(0,4).forEach(q=>triggerSeismoPulse(q.mag*0.6));
  }

  setStatus(mode === "live-ncs" ? "live-ncs" : mode === "live" ? "live" : "mock");
  rescueFeedUpdated();
  applyFilters();
  updateTopStats();
}

function setStatus(s){
  state.connectionStatus = s;
  statusDot.className = "status-dot pulse";
  if (s === "live"){
    statusDot.classList.remove("pulse");
    statusText.textContent = state.source === "india" ? "LIVE · USGS (India bbox)" : "LIVE · USGS";
  } else if (s === "live-ncs"){
    statusDot.classList.remove("pulse");
    statusText.textContent = "LIVE · NCS";
  } else if (s === "mock"){
    statusDot.classList.add("warn");
    statusText.textContent = "OFFLINE · SIMULATED";
  } else if (s === "error"){
    statusDot.classList.add("err");
    statusText.textContent = "CONNECTION ERROR";
  } else {
    statusText.textContent = "CONNECTING";
  }
}

