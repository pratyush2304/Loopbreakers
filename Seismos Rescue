  if(satelliteTiles.size>SAT_MAX_CACHED){
    for(const key of satelliteTiles.keys()){
      if(satelliteTiles.size<=SAT_MAX_CACHED)break;
      if(!visible.has(key))satelliteTiles.delete(key);
    }
  }
