    return generateMockFeature("mock"+i, s[0]+(Math.random()-0.5)*1.2, s[1]+(Math.random()-0.5)*1.2, mag, depth, s[2], Math.random()*1400);
  });
}
function buildMockIndiaDataset(){
  const seeds = [
    [77.2,28.6,"Delhi NCR"], [74.8,32.3,"Kangra, Himachal Pradesh"],
    [76.6,30.7,"Chandigarh region"], [88.6,27.3,"Gangtok, Sikkim"],
