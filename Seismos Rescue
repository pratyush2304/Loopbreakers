body[data-theme="light"] .map-layer-btn.active{background:#087f76;color:white;border-color:#087f76}
/* Map controls are always pointer-operable even though the HUD itself passes clicks through. */
.map-style-control{display:flex;gap:5px;align-items:center}
.map-layer-btn{padding:7px 10px;font:700 10px var(--mono);letter-spacing:.02em;cursor:pointer;border:1px solid var(--border);background:rgba(255,255,255,.06);color:var(--text-mid);border-radius:7px;min-height:30px}
.map-layer-btn:hover,.map-layer-btn:focus-visible{border-color:var(--accent);outline-offset:2px}
.map-layer-btn.active{background:rgba(94,224,192,.17);color:var(--accent);border-color:var(--accent)}
.map-legend{max-width:250px;line-height:1.5}
.map-legend summary{cursor:pointer;user-select:none;font-weight:700;letter-spacing:.035em;list-style:none;display:flex;align-items:center;gap:8px}
.map-legend summary::-webkit-details-marker{display:none}
.map-legend summary::before{content:'▸';opacity:.8}
.map-legend[open] summary::before{content:'▾'}
.map-legend .legend-content{margin-top:8px}
.map-attribution{position:absolute;right:12px;bottom:50px;z-index:5;max-width:300px;padding:5px 8px;border-radius:6px;border:1px solid var(--border);font:9px/1.4 var(--mono);background:rgba(7,12,19,.82);color:#e2e8f0;pointer-events:auto;text-align:right}
.map-attribution a{color:inherit;text-decoration:underline}
.map-loading{position:absolute;right:12px;bottom:88px;z-index:5;font:9px var(--mono);background:rgba(9,15,24,.78);color:#d7ece5;padding:5px 8px;border-radius:6px;pointer-events:none}
body[data-theme="light"] .map-loading{background:rgba(255,255,255,.92);color:#1d5661}
#theme-toggle{min-width:80px}
@media(max-width:1240px){.topbar-stats .source-toggle{display:none}}
@media(max-width:860px){
  .map-legend{max-width:215px}
  .map-attribution{bottom:44px;right:7px;font-size:8px;max-width:180px}
  .map-loading{bottom:74px;right:7px;max-width:170px}
  .map-layer-btn{font-size:9px;padding:6px 8px}
  .map-hud{max-height:calc(100% - 7px);overflow-y:auto;scrollbar-width:none}
