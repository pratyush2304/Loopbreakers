body[data-theme="light"] .action-btn{color:#09665d;background:#e8f8f4;border-color:rgba(13,125,112,.36)}
body[data-theme="light"] .action-btn.primary{color:#fff;background:#087f76;border-color:#087f76}
body[data-theme="light"] .action-btn.danger{background:#fff1f0;color:#a62b35;border-color:#dba2a5}
body[data-theme="light"] .action-btn:hover{background:#d4f1e9}
