body[data-theme="light"] .resp-stat b,body[data-theme="light"] .resp-card .title,body[data-theme="light"] .safety-card h3{color:#193449}
body[data-theme="light"] .resp-card{background:#f8fbfe;border-color:rgba(29,59,78,.17)}
body[data-theme="light"] .resp-card .meta{color:#5f7589}
body[data-theme="light"] .resp-card .desc,body[data-theme="light"] .safety-card{color:#344f62}
body[data-theme="light"] .resp-chip{color:#057c6e;background:#e4f8f2}
body[data-theme="light"] .resp-chip.demo{color:#915314;background:#fff1da}
body[data-theme="light"] .resp-chip.critical{color:#a42c35;background:#fff2f2}
body[data-theme="light"] .resp-message{color:#087f76}
body[data-theme="light"] .quake-card{background:#fff}
body[data-theme="light"] .quake-card:hover,body[data-theme="light"] .quake-card.selected{background:#e7f8f2}
body[data-theme="light"] .qc-mag{background:#f0f4f6}
body[data-theme="light"] .info-hud{color:#334e60;background:rgba(255,255,255,.92);border-color:rgba(17,96,89,.27)}
body[data-theme="light"] .info-hud strong{color:#173849}
body[data-theme="light"] .info-hud .data-age{color:#975814}
body[data-theme="light"] #data-timestamp{color:#416075}
body[data-theme="light"] .drill-watermark{color:#944800;background:rgba(255,246,226,.93)}
body[data-theme="light"] #seismo-wrap .seismo-label,body[data-theme="light"] .seismo-readout{color:#506879}
