async function startWaterDrill(){
 if(rescue.mode==='unavailable')return rescueToast('Backend unavailable. Cannot create shared drill.',true);
 const btn=$('#start-water-drill');btn.disabled=true;
 try{
  if(rescue.mode==='shared'){
   await rescueApi('/api/drill',{method:'POST',body:JSON.stringify({kind:'water'})});await rescueSync();
  }else{
   rescue.waterDrillActive=true;
   if(!rescue.incidents.some(x=>x.scenarioId===RESCUE_WATER_DEMO_ID)){
    const now=Date.now();rescue.incidents=RESCUE_WATER_DRILL_ITEMS.map((x,i)=>({...x,hazard:'water',id:rescueId(),status:i===2?'Acknowledged':'New',verified:false,scenarioId:RESCUE_WATER_DEMO_ID,createdAt:new Date(now-i*45000).toISOString()})).concat(rescue.incidents);
   }
   rescueSaveLocal();rescueRender();
  }
  $('#incident-filter').value='water';rescueRender();responseSwitchTab('response');
  const p=project(91.754,26.195);state.viewport.targetScale=6;
  state.viewport.targetX=mapW/2-p.x*6;state.viewport.targetY=mapH/2-p.y*6;
  rescueToast('FLOOD DRILL: six fictional Guwahati reports added — NOT a real flood warning.');
 }catch(error){rescueToast('Could not start flood drill: '+error.message,true);}finally{btn.disabled=rescue.mode==='shared'&&rescue.user?.role!=='responder';}
}
function renderRainfall(data){
 $('#water-mm').textContent=Number(data.forecast24hMm).toFixed(1);
 $('#water-prob').textContent=Math.round(data.maxPrecipProbabilityPct)+'%';
 $('#water-hours').textContent=String(data.hours.length);
 const chart=$('#water-hourly-chart');chart.replaceChildren();
 const max=Math.max(1,...data.hours.map(x=>x.mm));
 data.hours.forEach((hour,i)=>{
  const slot=document.createElement('div');slot.className='water-bar-slot';
  const bar=document.createElement('div');bar.className='water-bar';bar.style.height=(Math.max(3,hour.mm/max*92))+'px';
  bar.title=hour.time+': '+hour.mm+' mm · '+hour.probability+'% precipitation chance';
  const label=document.createElement('span');label.className='water-hour-label';
  label.textContent=i%4===0?hour.time.slice(11,13)+'h':'';
  slot.append(bar,label);chart.appendChild(slot);
 });
 chart.setAttribute('aria-label','Next '+data.hours.length+' model-forecast hours, total '+data.forecast24hMm+' mm of precipitation');
 $('#water-weather-status').textContent='Forecast fetched '+new Date(data.generatedAt).toLocaleString()+
  (data.cached?' · cached':'')+' · '+(data.hours.length===24?'Next 24 hours':'Partial hourly outlook')+'.';
 $('#water-model-notes').textContent='Source: '+data.source+' model forecast ('+data.modelTimezone+'). Not a river-level measurement or an official flood warning. Actual flooding depends on terrain, drainage, rivers and other conditions.';
}
let waterRequestId=0;
async function loadWaterForecast(){
 const button=$('#refresh-rainfall'),status=$('#water-weather-status');
 if(!rescue.home){status.textContent='Choose a city in Response → My location, or use GPS, before fetching rainfall.';return;}
 const request=++waterRequestId;button.disabled=true;
 $('#water-location-name').textContent=rescue.home.name+' ('+rescue.home.lat.toFixed(3)+', '+rescue.home.lon.toFixed(3)+')';
 status.textContent='Requesting model rainfall forecast…';
 try{
  const lat=rescue.home.lat,lon=rescue.home.lon;
  let data;
  try{if(rescue.mode!=='shared')throw new Error('Standalone mode: use the public forecast endpoint');data=await rescueApi('/api/rainfall?lat='+encodeURIComponent(lat)+'&lon='+encodeURIComponent(lon));}
  catch(error){
   if(rescue.mode==='shared')throw error;
   const u=new URL('https://api.open-meteo.com/v1/forecast');
   u.searchParams.set('latitude',lat);u.searchParams.set('longitude',lon);
   u.searchParams.set('hourly','precipitation,precipitation_probability');u.searchParams.set('current','precipitation');u.searchParams.set('timezone','auto');u.searchParams.set('forecast_days','3');
   const response=await fetch(u.toString());if(!response.ok)throw new Error('Open-Meteo HTTP '+response.status);
   const raw=await response.json();
   const hours=raw.hourly.time.map((time,i)=>({time,i})).filter(x=>x.time>=(raw.current?.time||raw.hourly.time[0])).slice(0,24).map(x=>({time:x.time,mm:Math.max(0,Number(raw.hourly.precipitation[x.i])||0),probability:Math.min(100,Math.max(0,Number(raw.hourly.precipitation_probability[x.i])||0))}));
   if(!hours.length)throw new Error('Weather forecast has no future hours');
   data={source:'Open-Meteo',modelTimezone:raw.timezone||'auto',generatedAt:new Date().toISOString(),hours,forecast24hMm:Number(hours.reduce((a,x)=>a+x.mm,0).toFixed(1)),maxPrecipProbabilityPct:Math.max(...hours.map(x=>x.probability))};
  }
  if(request===waterRequestId)renderRainfall(data);
 }catch(error){if(request===waterRequestId){status.textContent='Rainfall forecast unavailable: '+error.message+'. See official flood information below.';}}
 finally{if(request===waterRequestId)button.disabled=false;}
}

function setupResponse(){
  rescueReadLocal();
  $('#auth-mode-login').addEventListener('click',()=>{rescue.authMode='login';$('#auth-password').value='';rescueRenderAuth();});
  $('#auth-mode-register').addEventListener('click',()=>{rescue.authMode='register';$('#auth-password').value='';rescueRenderAuth();});
  $('#auth-form').addEventListener('submit',async(e)=>{
    e.preventDefault();const button=$('#auth-submit'),message=$('#auth-message');button.disabled=true;message.textContent='Authenticating…';message.classList.remove('error');
    try{
      const input={email:$('#auth-email').value,password:$('#auth-password').value};
      if(rescue.authMode==='register')input.name=$('#auth-name').value;
      const route=rescue.authMode==='register'?'/api/auth/register':'/api/auth/login';
      await rescueApi(route,{method:'POST',body:JSON.stringify(input)});
      $('#auth-password').value='';message.textContent='';
      await rescueRefreshSession();rescueToast('Account session established.');
    }catch(err){message.classList.add('error');message.textContent=err.message;}
    finally{button.disabled=false;}
  });
  $('#auth-logout').addEventListener('click',async()=>{
    try{await rescueApi('/api/auth/logout',{method:'POST',body:'{}'});rescue.authMode='login';await rescueRefreshSession();rescueToast('Signed out.');}
    catch(err){rescueToast('Sign out failed: '+err.message,true);}
  });
  $('#load-audit').addEventListener('click',rescueLoadAudit);
  $('#export-csv').addEventListener('click',()=>{
    if(rescue.mode!=='shared'||rescue.user?.role!=='responder')return rescueToast('CSV export requires a responder login on the server.',true);
    window.location.href='/api/export.csv';
  });
  rescueRenderAuth();
  const saved=(()=>{try{return localStorage.getItem(RESCUE_HOME_KEY)}catch(e){return null}})();
  if(saved&&RESCUE_CITIES[saved]){$('#home-city').value=saved;rescueSetHome(saved);}
  $('#home-city').addEventListener('change',()=>{
    if($('#home-city').value==='custom'){
      $('#home-city').value='';rescueToast('Use the GPS button to request your device location.');return;
    }
    rescueSetHome($('#home-city').value);
  });
  $('#locate-me').addEventListener('click',()=>{
    if(!navigator.geolocation){rescueToast('Geolocation is not supported by this browser.',true);return;}
    $('#locate-me').disabled=true;
    navigator.geolocation.getCurrentPosition(p=>{
      $('#locate-me').disabled=false;
      rescue.home={name:'Your device',lat:p.coords.latitude,lon:p.coords.longitude};
      $('#home-city').value='custom';rescueUpdateNearby();
      $('#incident-lat').value=rescue.home.lat.toFixed(5);
      $('#incident-lon').value=rescue.home.lon.toFixed(5);
      $('#incident-place').value='Device location (demo)';
      if(state.selected)showInspectorFor(state.selected);
      if(document.querySelector('.sb-tab[data-tab="water"]')?.classList.contains('active'))loadWaterForecast();
      rescueToast('Location obtained. Coordinates remain local unless you submit a demo report.');
    },e=>{$('#locate-me').disabled=false;rescueToast('Location unavailable or permission denied. Select a city instead.',true);},{timeout:10000,maximumAge:60000});
  });
  $('#use-city-for-report').addEventListener('click',()=>{
    if(!rescue.home){rescueToast('Select a city first.',true);return;}
    $('#incident-lat').value=rescue.home.lat.toFixed(5);
    $('#incident-lon').value=rescue.home.lon.toFixed(5);
    $('#incident-place').value=rescue.home.name;
  });
  $('#incident-form').addEventListener('submit',async(e)=>{
    e.preventDefault();
    const message=$('#incident-form-msg'),button=$('#submit-incident');button.disabled=true;
    message.classList.remove('error');message.textContent='Saving demo report…';
    try{
      const entry={hazard:$('#incident-hazard').value,type:$('#incident-type').value,urgency:$('#incident-urgency').value,
        place:$('#incident-place').value,description:$('#incident-desc').value,
        lat:$('#incident-lat').value,lon:$('#incident-lon').value};
      await rescueCreate(entry);
      $('#incident-desc').value='';
      message.textContent='Saved. Report visible in responder queue; NOT sent to emergency services.';
      rescueToast('Demo report saved. Review it in the response queue.');
    }catch(err){message.textContent=err.message;message.classList.add('error');}
    finally{button.disabled=false;}
  });
  $('#copy-brief').addEventListener('click',async()=>{
    const content='SEISMOS RESCUE — DEMO SITUATION BRIEF\n'+$('#incident-brief').textContent+'\nGenerated: '+new Date().toLocaleString();
    try{await navigator.clipboard.writeText(content);rescueToast('Demo situation brief copied.');}
    catch(e){rescueToast('Clipboard unavailable. Select and copy the situation brief text instead.',true);}
  });
  $('#resp-global').addEventListener('click',()=>document.querySelector('.src-btn[data-src="global"]').click());
  $('#resp-india').addEventListener('click',()=>document.querySelector('.src-btn[data-src="india"]').click());
  $('#incident-filter').addEventListener('change',rescueRender);
  $('#incident-hazard').addEventListener('change',updateIncidentTypeOptions);
  updateIncidentTypeOptions();
  $('#start-water-drill').addEventListener('click',startWaterDrill);
  $('#water-report').addEventListener('click',()=>{responseSwitchTab('response');$('#incident-hazard').value='water';updateIncidentTypeOptions();$('#incident-type').focus();});
  $('#water-use-location').addEventListener('click',()=>responseSwitchTab('response'));
  $('#refresh-rainfall').addEventListener('click',loadWaterForecast);
  document.querySelector('.sb-tab[data-tab="water"]').addEventListener('click',()=>{if(rescue.home)loadWaterForecast();});
  $('#start-drill').addEventListener('click',rescueStartDrill);
  $('#reset-drill').addEventListener('click',rescueClear);
  $('#report-help').addEventListener('click',()=>{responseSwitchTab('response');$('#incident-type').focus();});
  $('#open-response').addEventListener('click',()=>responseSwitchTab('response'));
  $('#open-safety').addEventListener('click',()=>responseSwitchTab('safety'));
  window.addEventListener('storage',e=>{
    if(e.key===RESCUE_STORAGE_KEY&&rescue.mode==='local'){rescueReadLocal();rescueRender();}
  });
  rescueRender();rescueUpdateNearby();rescueConnectServer();
  if('serviceWorker' in navigator && (location.protocol==='https:' || location.hostname==='localhost'||location.hostname==='127.0.0.1')){
    navigator.serviceWorker.register('/sw.js').catch(e=>console.info('Offline service worker unavailable:',e.message));
  }
}

/* =========================================================================
   BOOT BANNER — surfaces problems instead of failing silently
   ========================================================================= */
const bootBanner = document.getElementById("boot-banner");
function showBanner(html){
  if (!bootBanner) return;
  bootBanner.innerHTML = html;
  bootBanner.classList.add("show");
}

function checkEnvironment(){
  if (location.protocol === "file:"){
    showBanner(
      "⚠ Running from a local file (file://). Browsers block live fetches from file:// pages, " +
      "so this will run in OFFLINE · SIMULATED mode. To see live USGS data, serve this folder instead: " +
      "<b>python3 -m http.server 8000</b> then open <b>http://localhost:8000/index.html</b>."
    );
  }
}

/* =========================================================================
   BOOTSTRAP — wrapped so one failure can't leave a blank/frozen page
   ========================================================================= */
let booted = false;
function boot(){
  if (booted) return; // guard against double-invocation (load + readyState check)
  booted = true;
  try{
    checkEnvironment();
    resizeCanvases();
    initViewport();
    setupMapAppearance();
    setupResponse();
    fetchQuakes().catch(err=>{
      console.error("[Seismos] fetchQuakes rejected:", err);
      hideLoading();
      setStatus("error");
    });
    setInterval(()=>{
      fetchQuakes().catch(err=> console.error("[Seismos] poll failed:", err));
    }, POLL_INTERVAL_MS);
    requestAnimationFrame(mapFrame);
    requestAnimationFrame(seismoFrame);
  }catch(err){
    console.error("[Seismos] Fatal boot error:", err);
    hideLoading();
    showBanner("⚠ Failed to start: " + escapeHtml(err.message) + ". Check the browser console (F12) for details.");
  }
}

if (document.readyState === "complete" || document.readyState === "interactive"){
  boot();
} else {
  window.addEventListener("DOMContentLoaded", boot);
}
window.addEventListener("load", boot);
window.addEventListener("error", (e)=>{
  console.error("[Seismos] Uncaught error:", e.error || e.message);
});

})();
</script>
