/* =========================================================================
   INDIA · 90-DAY STATE HISTORY
   ========================================================================= */
function nearestState(lat, lon){
  let best = null, bestD = Infinity;
  for (const [name, slat, slon] of INDIA_STATES){
    const d = Math.hypot(lat - slat, lon - slon);
    if (d < bestD){ bestD = d; best = name; }
  }
  return best;
}

// The historical catalog is intentionally separate from the live feed and drills.
// Never populate it with generated/mock earthquake data.
const HISTORY_KEY = 'seismos-history-usgs-v3';
const HISTORY_DAYS = 90;
const HISTORY_DAY_MS = 86400000;
const HISTORY_FEED_FALLBACK = 'https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/2.5_month.geojson';

function histStatus(message, mode='ok'){
  histStatusEl.textContent=message;
  histStatusEl.className='history-status'+(mode==='ok'?'':' '+mode);
}
function historyDate(ms){
  return new Date(ms).toLocaleString(undefined,{day:'numeric',month:'short',hour:'2-digit',minute:'2-digit'});
}
function updateHistoryMetadata(meta){
  state.historyMetadata=meta;
  histCoverageEl.textContent=meta.coverageDays+' / '+HISTORY_DAYS+' days';
  histTotalEl.textContent=state.history90d.length.toLocaleString();
  histUpdatedEl.textContent=meta.fetchedAt?historyDate(meta.fetchedAt):'—';
  const source=meta.source||'USGS';
  const extra=meta.minimumMagnitude!==undefined?' · M ≥ '+meta.minimumMagnitude:'';
  if (meta.cached){
    histStatus('Showing saved USGS data ('+meta.coverageDays+'/90 days'+extra+'). Updated '+historyDate(meta.fetchedAt)+'. Refreshing when possible.', 'warn');
  }else if(meta.coverageDays<HISTORY_DAYS){
    histStatus('PARTIAL '+meta.coverageDays+'/90-day coverage · '+source+extra+'. Some historical intervals were unavailable; these counts are incomplete.', 'warn');
  }else{
    histStatus('VERIFIED CATALOG · '+source+' · '+HISTORY_DAYS+'-day coverage · '+state.history90d.length.toLocaleString()+' events. Not a live alert.');
  }
}
function usableHistoryEvent(q){
  return q&&typeof q.id==='string'&&Number.isFinite(q.lat)&&Number.isFinite(q.lon)&&
    Number.isFinite(q.mag)&&Number.isFinite(q.time)&&q.lat>=-90&&q.lat<=90&&q.lon>=-180&&q.lon<=180;
}
function applyHistoryPayload(payload,cached=false){
  if(!payload||!Array.isArray(payload.events)||!Number.isFinite(payload.coverageDays)||!Number.isFinite(payload.fetchedAt))throw new Error('Invalid history response');
  const unique=new Map();
  for(const q of payload.events){if(usableHistoryEvent(q))unique.set(q.id,q);}
  state.history90d=[...unique.values()];
  state.historyLoaded=true;
  updateHistoryMetadata({coverageDays:Math.max(0,Math.min(HISTORY_DAYS,Math.round(payload.coverageDays))),fetchedAt:payload.fetchedAt,
    source:payload.source||'USGS',minimumMagnitude:payload.minimumMagnitude,cached});
  renderStateHistory();
}
function readHistoryCache(){
  try{
    const value=localStorage.getItem(HISTORY_KEY);
    if(!value)return null;
    const parsed=JSON.parse(value);
    // Avoid displaying an arbitrarily old or structurally incompatible snapshot.
    if(!Number.isFinite(parsed.fetchedAt)||Date.now()-parsed.fetchedAt>7*HISTORY_DAY_MS)return null;
    return parsed;
  }catch(_){return null;}
}
function saveHistoryCache(payload){
  try{localStorage.setItem(HISTORY_KEY,JSON.stringify(payload));}
  catch(err){console.info('[Seismos] Local history cache unavailable:',err.message);}
}
function historyParams(start,end){
  return new URLSearchParams({format:'geojson',jsonerror:'true',starttime:new Date(start).toISOString(),
    endtime:new Date(end).toISOString(),minlatitude:String(INDIA_BBOX.minLat),maxlatitude:String(INDIA_BBOX.maxLat),
    minlongitude:String(INDIA_BBOX.minLon),maxlongitude:String(INDIA_BBOX.maxLon),minmagnitude:'0',orderby:'time'});
}
function historyNormalize(features){
  if(!Array.isArray(features))throw new Error('USGS returned an invalid event collection');
  return features.map(f=>{
    const coords=f&&f.geometry&&f.geometry.coordinates,p=f&&f.properties;
    if(!Array.isArray(coords)||!p)return null;
    return {id:String(f.id||p.code||''),lon:Number(coords[0]),lat:Number(coords[1]),depth:Number(coords[2]||0),
      mag:Number(p.mag),place:String(p.place||'Unknown location'),time:Number(p.time)};
  }).filter(usableHistoryEvent).filter(q=>q.lat>=INDIA_BBOX.minLat&&q.lat<=INDIA_BBOX.maxLat&&q.lon>=INDIA_BBOX.minLon&&q.lon<=INDIA_BBOX.maxLon);
}
async function historyFetchJSON(url,ms=18000){
  const controller=new AbortController(),timer=setTimeout(()=>controller.abort(),ms);
  try{
    const res=await fetch(url,{cache:'no-store',signal:controller.signal});
    if(res.status===204)return {features:[]};
    if(!res.ok){
      let body='';try{body=(await res.text()).slice(0,220).replace(/\s+/g,' ');}catch(_){}
      throw new Error('USGS HTTP '+res.status+(body?' — '+body:''));
    }
    return await res.json();
  }catch(err){
    if(err.name==='AbortError')throw new Error('USGS request timed out after '+(ms/1000)+'s');
    throw err;
  }finally{clearTimeout(timer);}
}
async function historyChunk(start,end,depth=0){
  try{
    const json=await historyFetchJSON(USGS_QUERY_BASE+'?'+historyParams(start,end));
    return historyNormalize(json.features);
  }catch(err){
    // USGS returns 400 if a search has more than 20,000 results. Split a large
    // failing interval once rather than silently truncating the event count.
    if(/HTTP 400/.test(err.message)&&depth<3&&(end-start)>3*HISTORY_DAY_MS){
      const mid=start+Math.floor((end-start)/2);
      const parts=await Promise.all([historyChunk(start,mid,depth+1),historyChunk(mid,end,depth+1)]);
      return parts.flat();
    }
    throw err;
  }
}
async function historyDirect(){
  const end=Date.now(),start=end-HISTORY_DAYS*HISTORY_DAY_MS;
  const chunks=[0,1,2].map(i=>({start:start+i*30*HISTORY_DAY_MS,end:start+(i+1)*30*HISTORY_DAY_MS}));
  const results=await Promise.allSettled(chunks.map(c=>historyChunk(c.start,c.end)));
  const events=[],errors=[];let coverageDays=0;
  results.forEach((r,i)=>{
    if(r.status==='fulfilled'){events.push(...r.value);coverageDays+=30;}
    else errors.push('Period '+(i+1)+': '+r.reason.message);
  });
  if(coverageDays){
    if(errors.length)console.warn('[Seismos] Missing history periods:',errors.join(' | '));
    return {events,coverageDays,source:'USGS catalog (browser)',fetchedAt:Date.now()};
  }
  // A restricted and clearly labeled partial-data fallback, never represented as 90 days.
  try{
    const json=await historyFetchJSON(HISTORY_FEED_FALLBACK,16000);
    return {events:historyNormalize(json.features),coverageDays:30,minimumMagnitude:2.5,
      source:'USGS M2.5+ last-month feed (fallback)',fetchedAt:Date.now()};
  }catch(err){
    throw new Error((errors[0]||'Catalog request failed')+'; monthly fallback: '+err.message);
  }
}
async function loadIndiaHistory(){
  if(state.historyLoading)return;
  state.historyLoading=true;
  histRefreshBtn.classList.add('loading');histRefreshBtn.disabled=true;
  histRefreshBtn.textContent='↻ Loading real earthquake records…';
  if(!state.historyLoaded){
    const cached=readHistoryCache();
    if(cached){try{applyHistoryPayload(cached,true);}catch(err){console.info('[Seismos] Invalid history cache:',err.message);}}
  }
  if(!state.historyLoaded)histStatus('Loading 90 days of USGS earthquakes in three smaller requests…','loading');
  else histStatus('Refreshing from USGS. Existing verified records remain visible…','loading');
  const failures=[];
  try{
    let payload=null;
    // The Node demo server proxies the USGS catalog without browser-side CORS issues.
    // If served statically (or file://), fall back to direct browser requests.
    if(location.protocol!=='file:'){
      try{
        const controller=new AbortController(),timer=setTimeout(()=>controller.abort(),35000);
        try{
          const res=await fetch('/api/history',{cache:'no-store',signal:controller.signal});
          if(!res.ok){const body=await res.json().catch(()=>({}));throw new Error(body.error||'Demo server history route HTTP '+res.status);}
          payload=await res.json();
        }finally{clearTimeout(timer);}
      }catch(err){failures.push('Server: '+(err.name==='AbortError'?'request timed out':err.message));}
    }
    if(!payload){
      histStatus('Fetching smaller USGS date ranges directly from the browser…','loading');
      payload=await historyDirect();
    }
    applyHistoryPayload(payload);
    saveHistoryCache(payload);
    if(failures.length)console.info('[Seismos] History source fallback:',failures.join(' | '));
  }catch(err){
    console.warn('[Seismos] History unavailable:',failures.concat(err.message).join(' | '));
    const detail=err.message.slice(0,240);
    if(state.historyLoaded){
      histStatus('Refresh failed; keeping previously downloaded records. '+detail,'warn');
    }else{
      histStatus('Historical USGS data unavailable: '+detail+'. Check internet or retry when the catalog is available.','error');
      stateList.innerHTML='<div class="empty-state"><span>No real earthquake history is available yet. No synthetic records will be shown.</span></div>';
      histCount.textContent='0';
    }
  }finally{
    state.historyLoading=false;histRefreshBtn.disabled=false;
    histRefreshBtn.classList.remove('loading');histRefreshBtn.textContent='↻ Refresh earthquake history';
  }
}

function renderStateHistory(){
  const byState = new Map();
  state.history90d.forEach(q=>{
    const name = nearestState(q.lat, q.lon);
    if (!byState.has(name)) byState.set(name, { count:0, maxMag:0, sumMag:0 });
    const b = byState.get(name);
    b.count += 1;
    b.sumMag += q.mag;
    if (q.mag > b.maxMag) b.maxMag = q.mag;
  });

  const rows = Array.from(byState.entries())
    .map(([name, b]) => ({ name, count:b.count, maxMag:b.maxMag, avgMag: b.sumMag/b.count }))
    .sort((a,b)=> b.maxMag - a.maxMag);

  histCount.textContent = state.history90d.length;

  if (rows.length === 0){
    stateList.innerHTML = '<div class="empty-state">' +
      '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 12h5l2-7 4 14 3-9 2 4h4"/></svg>' +
      "<span>No recorded events in the last ~90 days within India's bounding box.</span></div>";
    return;
  }

  const globalMax = Math.max(...rows.map(r=>r.maxMag), 1);
  const frag = document.createDocumentFragment();
  rows.forEach((r, i)=>{
    const row = document.createElement("div");
    row.className = "state-row";
    const color = r.maxMag >= 6.0 ? "var(--red)" : r.maxMag >= 4.5 ? "var(--yellow)" : "var(--green)";
    const pct = Math.max(6, (r.maxMag / globalMax) * 100);
    row.innerHTML =
      '<div class="state-rank">' + (i+1) + '</div>' +
      '<div class="state-col">' +
        '<div class="state-name">' + escapeHtml(r.name) + '</div>' +
        '<div class="state-bar-track"><div class="state-bar-fill" style="width:' + pct.toFixed(0) + '%"></div></div>' +
      '</div>' +
      '<div class="state-stats">' +
        '<div class="state-maxmag" style="color:' + color + '">M' + r.maxMag.toFixed(1) + '</div>' +
        '<div class="state-count">' + r.count + ' events</div>' +
      '</div>';
    frag.appendChild(row);
  });
  stateList.innerHTML = "";
  stateList.appendChild(frag);
}

/* =========================================================================
   SELECTION / INSPECTOR
   ========================================================================= */
function selectQuake(q, centerOnMap){
  state.selected = q;
  document.querySelectorAll(".quake-card").forEach(c=>{
    c.classList.toggle("selected", c.dataset.id === q.id);
  });
  showInspectorFor(q);
  if (centerOnMap) panToQuake(q);
}

function panToQuake(q){
  const p = project(q.lon, q.lat);
  state.viewport.targetScale = Math.max(state.viewport.targetScale, 2.2);
  state.viewport.targetX = mapW/2 - p.x * state.viewport.targetScale;
  state.viewport.targetY = mapH/2 - p.y * state.viewport.targetScale;
}

function showInspectorFor(q){
  $("#insp-mag").textContent = "M " + q.mag.toFixed(1);
  $("#insp-mag").style.color = q.alertLevel === "red" ? "var(--red)" : q.alertLevel === "yellow" ? "var(--yellow)" : "var(--green)";
  $("#insp-place").textContent = q.place;
  $("#insp-depth").textContent = q.depth.toFixed(1) + " km";
  $("#insp-time").textContent = new Date(q.time).toLocaleString(undefined,{hour:'2-digit',minute:'2-digit',month:'short',day:'numeric'});
  $("#insp-coords").textContent = q.lat.toFixed(2) + "°, " + q.lon.toFixed(2) + "°";

  // Do not show misleading arrival-time estimates from an event catalog.
  // It is not an earthquake early warning service. Show factual distance only.
  const epicenterKm = rescue.home ? haversineKm(rescue.home.lat,rescue.home.lon,q.lat,q.lon) : null;
  $("#insp-p").textContent = epicenterKm === null ? "select city" : Math.round(epicenterKm).toLocaleString() + " km";
  $("#insp-s").textContent = state.connectionStatus === "mock" ? "SIMULATED" :
    state.connectionStatus === "live-ncs" ? "NCS" : state.connectionStatus === "live" ? "USGS" : "Last loaded";

  const tag = $("#insp-tag");
  tag.textContent = q.alertLevel === "red" ? "M ≥ 6 · Magnitude only" : q.alertLevel === "yellow" ? "M 4.5–6 · Magnitude only" : "M < 4.5 · Magnitude only";
  tag.style.background = q.alertLevel==="red" ? "rgba(255,92,92,0.15)" : q.alertLevel==="yellow" ? "rgba(242,201,76,0.15)" : "rgba(61,220,132,0.15)";
  tag.style.color = q.alertLevel==="red" ? "var(--red)" : q.alertLevel==="yellow" ? "var(--yellow)" : "var(--green)";

  inspector.classList.add("show");
}

function magToApproxRadiusKm(mag){
  return Math.pow(10, (mag - 1) * 0.5) * 8;
}

/* =========================================================================
   VIEWPORT: PAN / ZOOM / INERTIA
   ========================================================================= */
function initViewport(){
  state.viewport.scale = 1;
  state.viewport.targetScale = 1;
  state.viewport.x = 0;
  state.viewport.y = 0;
  state.viewport.targetX = 0;
  state.viewport.targetY = 0;
}

let inertiaVX = 0, inertiaVY = 0;
let lastDragPos = null, lastDragTime = 0;

mapCanvas.addEventListener("mousedown", (e)=>{
  state.dragging = true;
  mapCanvas.classList.add("dragging");
  state.dragStart = { x: e.clientX, y: e.clientY, vx: state.viewport.x, vy: state.viewport.y };
  lastDragPos = { x: e.clientX, y: e.clientY };
  lastDragTime = performance.now();
  inertiaVX = 0; inertiaVY = 0;
});
window.addEventListener("mousemove", (e)=>{
  const rect = mapCanvas.getBoundingClientRect();
  state.lastPointer = { x: e.clientX - rect.left, y: e.clientY - rect.top };
  if (!state.dragging) { handleHover(state.lastPointer); return; }
  const dx = e.clientX - state.dragStart.x;
  const dy = e.clientY - state.dragStart.y;
  state.viewport.x = state.dragStart.vx + dx;
  state.viewport.y = state.dragStart.vy + dy;
  state.viewport.targetX = state.viewport.x;
  state.viewport.targetY = state.viewport.y;

  const now = performance.now();
  const dt = Math.max(1, now - lastDragTime);
  inertiaVX = (e.clientX - lastDragPos.x) / dt * 16;
  inertiaVY = (e.clientY - lastDragPos.y) / dt * 16;
  lastDragPos = { x: e.clientX, y: e.clientY };
  lastDragTime = now;
});
window.addEventListener("mouseup", ()=>{
  if (state.dragging){
    state.dragging = false;
    mapCanvas.classList.remove("dragging");
    state.viewport.targetX = state.viewport.x;
    state.viewport.targetY = state.viewport.y;
  }
});

mapCanvas.addEventListener("wheel", (e)=>{
  e.preventDefault();
  const rect = mapCanvas.getBoundingClientRect();
  const mx = e.clientX - rect.left, my = e.clientY - rect.top;
  const vp = state.viewport;
  const zoomFactor = Math.exp(-e.deltaY * 0.0016);
  const newScale = clamp(vp.targetScale * zoomFactor, 1, 8192);

  const worldX = (mx - vp.targetX) / vp.targetScale;
  const worldY = (my - vp.targetY) / vp.targetScale;
  vp.targetScale = newScale;
  vp.targetX = mx - worldX * newScale;
  vp.targetY = my - worldY * newScale;
}, { passive:false });

function clamp(v, lo, hi){ return Math.max(lo, Math.min(hi, v)); }

$("#zoom-in").addEventListener("click", ()=> zoomStep(1.4));
$("#zoom-out").addEventListener("click", ()=> zoomStep(1/1.4));
$("#zoom-reset").addEventListener("click", ()=>{
  if (state.source === "india"){
    const p = project(80.5, 22.5);
    state.viewport.targetScale = 4.2;
    state.viewport.targetX = mapW/2 - p.x * state.viewport.targetScale;
    state.viewport.targetY = mapH/2 - p.y * state.viewport.targetScale;
  } else {
    state.viewport.targetScale = 1;
    state.viewport.targetX = 0;
    state.viewport.targetY = 0;
  }
  state.selected = null;
  inspector.classList.remove("show");
});
function zoomStep(factor){
  const vp = state.viewport;
  const cx = mapW/2, cy = mapH/2;
  const worldX = (cx - vp.targetX)/vp.targetScale;
  const worldY = (cy - vp.targetY)/vp.targetScale;
  vp.targetScale = clamp(vp.targetScale * factor, 1, 8192);
  vp.targetX = cx - worldX * vp.targetScale;
  vp.targetY = cy - worldY * vp.targetScale;
}

mapCanvas.addEventListener("click", (e)=>{
  if (Math.abs(inertiaVX) > 2 || Math.abs(inertiaVY) > 2) return;
  const rect = mapCanvas.getBoundingClientRect();
  const mx = e.clientX - rect.left, my = e.clientY - rect.top;
  const reportHit = rescueHitTest(mx,my);
  if(reportHit){ rescueFocusIncident(reportHit); return; }
  const hit = hitTest(mx, my);
  if (hit){
    selectQuake(hit, false);
    positionInspectorNear(mx, my);
  } else {
    state.selected = null;
    inspector.classList.remove("show");
    document.querySelectorAll(".quake-card").forEach(c=>c.classList.remove("selected"));
  }
});

function hitTest(mx, my){
  let best = null, bestD = Infinity;
  for (const q of state.filtered){
    const s = worldToScreen(q.lon, q.lat);
    const r = Math.max(5, radiusForMag(q.mag) * state.viewport.scale * 0.5) + 6;
    const d = Math.hypot(mx - s.x, my - s.y);
    if (d < r && d < bestD){ bestD = d; best = q; }
  }
  return best;
}

function handleHover(pt){
  const reportHit = rescueHitTest(pt.x, pt.y);
  const hit = hitTest(pt.x, pt.y);
  if(reportHit){mapCanvas.style.cursor="pointer";return;}
  if (hit !== state.hovered){
    state.hovered = hit;
    mapCanvas.style.cursor = hit ? "pointer" : (state.dragging ? "grabbing" : "grab");
  }
}

function positionInspectorNear(mx, my){
  let left = mx + 18, top = my - 10;
  const maxLeft = mapW - 266;
  const maxTop = mapH - 220;
  if (left > maxLeft) left = mx - 268;
  if (top > maxTop) top = maxTop;
  if (top < 8) top = 8;
  inspector.style.left = left + "px";
  inspector.style.top = top + "px";
}

let touchLast = null;
mapCanvas.addEventListener("touchstart", (e)=>{
  if (e.touches.length===1){
    touchLast = { x:e.touches[0].clientX, y:e.touches[0].clientY };
  }
}, {passive:true});
mapCanvas.addEventListener("touchmove", (e)=>{
  if (e.touches.length===1 && touchLast){
    const dx = e.touches[0].clientX - touchLast.x;
    const dy = e.touches[0].clientY - touchLast.y;
    state.viewport.x += dx; state.viewport.y += dy;
    state.viewport.targetX = state.viewport.x; state.viewport.targetY = state.viewport.y;
    touchLast = { x:e.touches[0].clientX, y:e.touches[0].clientY };
  }
}, {passive:true});
mapCanvas.addEventListener("touchend", ()=>{ touchLast = null; });

/* =========================================================================
   RADIUS SCALING FOR MAGNITUDE
   ========================================================================= */
function radiusForMag(mag){
  return 2.2 + Math.pow(Math.max(mag,0.5), 1.7) * 0.85;
}

/* =========================================================================
   MAP RENDERING
   ========================================================================= */
function drawPath(ctx, coords, closeStroke){
  ctx.beginPath();
  coords.forEach(([lon,lat], i)=>{
    const s = worldToScreen(lon, lat);
    if (i===0) ctx.moveTo(s.x, s.y); else ctx.lineTo(s.x, s.y);
  });
  if (closeStroke) ctx.closePath();
}

function drawGraticule(){
  mapCtx.save();
  mapCtx.strokeStyle = "rgba(255,255,255,0.045)";
  mapCtx.lineWidth = 1;
  for (let lon=-180; lon<=180; lon+=30){
    mapCtx.beginPath();
    const a = worldToScreen(lon,90), b = worldToScreen(lon,-90);
    mapCtx.moveTo(a.x,a.y); mapCtx.lineTo(b.x,b.y); mapCtx.stroke();
  }
  for (let lat=-60; lat<=60; lat+=30){
    mapCtx.beginPath();
    const a = worldToScreen(-180,lat), b = worldToScreen(180,lat);
    mapCtx.moveTo(a.x,a.y); mapCtx.lineTo(b.x,b.y); mapCtx.stroke();
  }
  mapCtx.strokeStyle = "rgba(94,224,192,0.09)";
  mapCtx.beginPath();
  const a = worldToScreen(-180,0), b = worldToScreen(180,0);
  mapCtx.moveTo(a.x,a.y); mapCtx.lineTo(b.x,b.y); mapCtx.stroke();
  mapCtx.restore();
}

function drawContinents(){
  mapCtx.save();
  mapCtx.fillStyle = currentTheme==='light'?'rgba(57,112,98,.2)':'rgba(148,163,184,.08)';
  mapCtx.strokeStyle = currentTheme==='light'?'rgba(46,99,86,.66)':'rgba(148,163,184,.42)';
  mapCtx.lineWidth = 1;
  CONTINENTS.forEach(coords=>{
    drawPath(mapCtx, coords, true);
    mapCtx.fill();
    mapCtx.stroke();
  });
  mapCtx.restore();
}

let plateDashOffset = 0;
function drawPlateBoundaries(dt){
  plateDashOffset -= dt * 0.012;
  mapCtx.save();
  mapCtx.strokeStyle = "rgba(255,138,92,0.4)";
  mapCtx.lineWidth = 1.4;
  mapCtx.setLineDash([5,4]);
  mapCtx.lineDashOffset = plateDashOffset;
  PLATE_BOUNDARIES.forEach(coords=>{
    drawPath(mapCtx, coords, false);
    mapCtx.stroke();
  });
  mapCtx.setLineDash([]);
  mapCtx.restore();
}

function drawQuakeMarkers(nowMs){
  const vp = state.viewport;
  const kmPerPx = kmPerPixelAtScale(vp.scale);

  for (const q of state.filtered){
    const ageSec = (nowMs - q.time) / 1000;
    if (ageSec < 0 || ageSec > 2600) continue;
    const s = worldToScreen(q.lon, q.lat);

    const pRadiusKm = P_WAVE_SPEED * ageSec;
    const sRadiusKm = S_WAVE_SPEED * ageSec;
    const pRadiusPx = pRadiusKm / kmPerPx;
    const sRadiusPx = sRadiusKm / kmPerPx;

    const maxFadeKm = magToApproxRadiusKm(q.mag) * 2.2;
    const pFade = clamp(1 - pRadiusKm / maxFadeKm, 0, 1);
    const sFade = clamp(1 - sRadiusKm / maxFadeKm, 0, 1);

    if (pFade > 0.01 && pRadiusPx < Math.max(mapW,mapH)*1.5){
      mapCtx.save();
      mapCtx.strokeStyle = "rgba(94,224,192," + (pFade*0.55).toFixed(3) + ")";
      mapCtx.lineWidth = 1.4;
      mapCtx.beginPath();
      mapCtx.arc(s.x, s.y, Math.max(0,pRadiusPx), 0, Math.PI*2);
      mapCtx.stroke();
      mapCtx.restore();
    }
    if (sFade > 0.01 && sRadiusPx < Math.max(mapW,mapH)*1.5){
      mapCtx.save();
      mapCtx.strokeStyle = "rgba(255,138,92," + (sFade*0.6).toFixed(3) + ")";
      mapCtx.lineWidth = 1.8;
      mapCtx.beginPath();
      mapCtx.arc(s.x, s.y, Math.max(0,sRadiusPx), 0, Math.PI*2);
      mapCtx.stroke();
      mapCtx.restore();
    }
  }

  for (const q of state.filtered){
    const s = worldToScreen(q.lon, q.lat);
    if (s.x < -30 || s.x > mapW+30 || s.y < -30 || s.y > mapH+30) continue;

    const r = radiusForMag(q.mag) * Math.min(vp.scale, 2.4) * 0.55;
    const ageSec = (nowMs - q.time)/1000;
    const isFresh = ageSec >= 0 && ageSec < 8;
    const color = q.alertLevel === "red" ? "255,92,92" : q.alertLevel === "yellow" ? "242,201,76" : "61,220,132";

    if (isFresh){
      const pulseT = (ageSec % 1.6) / 1.6;
      mapCtx.save();
      mapCtx.strokeStyle = "rgba(" + color + "," + (1-pulseT)*0.7 + ")";
      mapCtx.lineWidth = 2;
      mapCtx.beginPath();
      mapCtx.arc(s.x, s.y, r + pulseT*18, 0, Math.PI*2);
      mapCtx.stroke();
      mapCtx.restore();
    }

    mapCtx.save();
    mapCtx.beginPath();
    mapCtx.arc(s.x, s.y, r, 0, Math.PI*2);
    mapCtx.fillStyle = "rgba(" + color + "," + (state.selected===q ? 0.95 : 0.75) + ")";
    mapCtx.fill();
    if (state.selected === q || state.hovered === q){
      mapCtx.lineWidth = 2;
      mapCtx.strokeStyle = "#ffffff";
      mapCtx.stroke();
    } else {
      mapCtx.lineWidth = 1;
      mapCtx.strokeStyle = "rgba(255,255,255,0.5)";
      mapCtx.stroke();
    }
    mapCtx.restore();
  }
}

function updateScaleBar(){
  const kmPerPx = kmPerPixelAtScale(state.viewport.scale);
  const targetPx = 80;
  const rawKm = kmPerPx * targetPx;
  const niceKm = niceNumber(rawKm);
  const px = niceKm / kmPerPx;
  scaleLine.style.width = Math.max(20,px) + "px";
  scaleLabel.textContent = niceKm >= 1000 ? (niceKm/1000)+",000 km" : niceKm + " km";
}
function niceNumber(x){
  const exp = Math.floor(Math.log10(x));
  const base = x / Math.pow(10, exp);
  let nice;
  if (base < 1.5) nice = 1; else if (base < 3.5) nice = 2; else if (base < 7.5) nice = 5; else nice = 10;
  return nice * Math.pow(10, exp);
}

/* =========================================================================
   MAIN MAP ANIMATION LOOP
   ========================================================================= */
let lastFrameTime = performance.now();
function mapFrame(now){
  if (mapW < 2 || mapH < 2){
    // layout hasn't painted yet (common right after boot) — retry next frame
    resizeCanvases();
    requestAnimationFrame(mapFrame);
    return;
  }
  const dt = now - lastFrameTime;
  lastFrameTime = now;

  const vp = state.viewport;
  if (!state.dragging){
    if (Math.abs(inertiaVX) > 0.02 || Math.abs(inertiaVY) > 0.02){
      vp.targetX += inertiaVX;
      vp.targetY += inertiaVY;
      inertiaVX *= 0.92;
      inertiaVY *= 0.92;
    }
  }
  const ease = 1 - Math.pow(0.001, dt/1000 || 0.001);
  vp.scale += (vp.targetScale - vp.scale) * Math.min(1, ease*1.4);
  vp.x += (vp.targetX - vp.x) * Math.min(1, ease*1.4);
  vp.y += (vp.targetY - vp.y) * Math.min(1, ease*1.4);

  mapCtx.clearRect(0,0,mapW,mapH);
  // Schematic atlas is a guaranteed fallback when external imagery is blocked.
  mapCtx.fillStyle = currentTheme==='light'?'#bed1de':'#0b1723';
  mapCtx.fillRect(0,0,mapW,mapH);
  if(currentMapStyle==='satellite'){
    // Geometry and xyz imagery use the same Web Mercator projection.
    const tilesReady=drawSatelliteTiles();
    if(tilesReady){
      if(currentTheme==='dark'){
        mapCtx.fillStyle='rgba(2,10,20,.18)';
        mapCtx.fillRect(0,0,mapW,mapH);
      }
    }else{
      drawGraticule();
      drawContinents();
    }
  }else{
    drawGraticule();
    drawContinents();
  }
  drawPlateBoundaries(dt);
  drawQuakeMarkers(Date.now());
  drawRescueMarkers();
  updateScaleBar();

  requestAnimationFrame(mapFrame);
}

/* =========================================================================
   SEISMOGRAPH: simplex-ish noise + decaying pulses
   ========================================================================= */
function makeNoise1D(seed){
  let s = seed;
  function rand(){ s = (s*9301+49297)%233280; return s/233280; }
  const grid = [];
  for (let i=0;i<256;i++) grid.push(rand()*2-1);
  return function(x){
    const xi = Math.floor(x) & 255;
    const xf = x - Math.floor(x);
    const a = grid[xi], b = grid[(xi+1)&255];
    const t = xf*xf*(3-2*xf);
    return a + (b-a)*t;
  };
}
const noise1 = makeNoise1D(1337);
const noise2 = makeNoise1D(9001);

const seismoPulses = [];
let seismoPeak = 0;
let seismoEventCount = 0;

function triggerSeismoPulse(mag){
  seismoPulses.push({ start: performance.now(), mag: mag || 1 });
  seismoEventCount++;
  seismoCountEl.textContent = seismoEventCount;
  if (seismoPulses.length > 40) seismoPulses.shift();
}

const seismoHistory = [];
let seismoT = 0;

function computeAmplitude(tSec){
  let base = noise1(tSec*1.7)*0.12 + noise2(tSec*4.3)*0.06;
  let pulseContribution = 0;
  const nowPerf = performance.now();
  for (const p of seismoPulses){
    const age = (nowPerf - p.start)/1000;
    if (age < 0 || age > 14) continue;
    const amp = Math.min(1.4, p.mag/6) * Math.exp(-age*1.3) * Math.sin(age*26);
    pulseContribution += amp;
  }
  return base + pulseContribution;
}

function seismoFrame(){
  if (seismoW < 2 || seismoH < 2){
    resizeCanvases();
    requestAnimationFrame(seismoFrame);
    return;
  }
  seismoT += 1/60;
  const amp = computeAmplitude(seismoT);
  seismoHistory.push(amp);
  const maxSamples = Math.ceil(seismoW) + 4;
  while (seismoHistory.length > maxSamples) seismoHistory.shift();

  seismoPeak = Math.max(seismoPeak*0.995, Math.abs(amp));
  seismoPeakEl.textContent = seismoPeak.toFixed(2);

  seismoCtx.clearRect(0,0,seismoW,seismoH);

  seismoCtx.save();
  seismoCtx.strokeStyle = "rgba(255,255,255,0.04)";
  seismoCtx.lineWidth = 1;
  const midY = seismoH/2;
  for (let gx=seismoW; gx>0; gx-=40){
    seismoCtx.beginPath(); seismoCtx.moveTo(gx,0); seismoCtx.lineTo(gx,seismoH); seismoCtx.stroke();
  }
  seismoCtx.beginPath();
  seismoCtx.moveTo(0, midY); seismoCtx.lineTo(seismoW, midY);
  seismoCtx.strokeStyle = "rgba(255,255,255,0.06)";
  seismoCtx.stroke();
  seismoCtx.restore();

  seismoCtx.save();
  seismoCtx.beginPath();
  const scaleY = seismoH * 0.34;
  seismoHistory.forEach((v, i)=>{
    const x = seismoW - (seismoHistory.length - i);
    const y = midY - v*scaleY;
    if (i===0) seismoCtx.moveTo(x,y); else seismoCtx.lineTo(x,y);
  });
  seismoCtx.strokeStyle = "#5ee0c0";
  seismoCtx.lineWidth = 1.6;
  seismoCtx.shadowColor = "rgba(94,224,192,0.6)";
  seismoCtx.shadowBlur = 6;
  seismoCtx.stroke();
  seismoCtx.restore();

  seismoCtx.save();
  const headGrad = seismoCtx.createLinearGradient(seismoW-40,0,seismoW,0);
  headGrad.addColorStop(0,"rgba(94,224,192,0)");
  headGrad.addColorStop(1,"rgba(94,224,192,0.15)");
  seismoCtx.fillStyle = headGrad;
  seismoCtx.fillRect(seismoW-40,0,40,seismoH);
  seismoCtx.restore();

  requestAnimationFrame(seismoFrame);
}

