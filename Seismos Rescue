function rescueConnectEvents(){
  if(rescue.eventStream){rescue.eventStream.close();rescue.eventStream=null;}
  if(rescue.pollTimer){clearInterval(rescue.pollTimer);rescue.pollTimer=null;}
  if(rescue.mode!=='shared'||!rescue.user)return;
  if(rescue.syncMode==='poll'){
    // Serverless functions cannot share process-local SSE subscriber lists.
    // Poll only when visible; do not claim instant updates.
    rescue.pollTimer=setInterval(()=>{
      if(document.visibilityState==='visible')rescueSync().catch(()=>$('#storage-mode').textContent='● Sync failed · retrying');
    },5000);
    return;
  }
  if(typeof EventSource!=='undefined'){
    rescue.eventStream=new EventSource('/api/events');
    rescue.eventStream.addEventListener('changed',()=>rescueSync().catch(err=>rescueToast('Sync interrupted: '+err.message,true)));
    rescue.eventStream.addEventListener('error',()=>{$('#storage-mode').textContent='● Event stream reconnecting…';});
    rescue.eventStream.addEventListener('open',()=>rescueRender());
  }
}
