        // Update Map insertion order for simple bounded least-recently-used cache.
        satelliteTiles.delete(key);satelliteTiles.set(key,tile);
      }
      if(tile.status==='loaded'){
        loaded++;
        const sx=left+x*tilePixels,sy=top+y*tilePixels;
        // Cover 0.5px rounding seams without changing the geographic alignment.
        mapCtx.drawImage(tile.img,sx,sy,tilePixels+0.35,tilePixels+0.35);
      }else if(tile.status==='loading'){loading++;}else failed++;
    }
  }
